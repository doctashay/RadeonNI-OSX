+        map.bytes >= bytes && map.bytes <= rounded &&
+        map.address <= UINTPTR_MAX && map.bytes <= UINTPTR_MAX - map.address;
+  }
+  BackendStatus Fail(BackendStatus status) { Destroy(); return status; }
+  const bool validation_;
+  io_connect_t connection_ = IO_OBJECT_NULL;
+  bool created_ = false;
+  Mapping maps_[3];
+  rdn_video_session session_ = {};
+  rdn_uvd_h264_config config_ = {};
+  uint32_t next_request_ = 1, next_output_ = 1;
+};
+}
+std::unique_ptr<Backend> CreateIOKitBackend() {
+  return std::make_unique<IOKitBackend>(false);
+}
