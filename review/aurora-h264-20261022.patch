+      if (!slices_) {
+        const media::H264Picture* refs[16] = {};
+        for (size_t i = 0; i < refs_.size(); ++i) refs[i] = refs_[i].get();
+        Result result = MapPicture(sps_, pps_, *current_, *slice, refs,
