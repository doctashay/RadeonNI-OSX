+#define RDN_VIDEO_MEMORY_OUTPUT0 0x101u
+#define RDN_VIDEO_MEMORY_OUTPUT1 0x102u
+#define RDN_VIDEO_MAX_UPLOAD_BYTES (4u * 1024u * 1024u)
+#define RDN_VIDEO_OUTPUT_SLOTS 2u
+#define RDN_VIDEO_CREATE_VALIDATION 1u
