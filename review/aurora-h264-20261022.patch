+// Scratch prototype; no device access or capability enablement.
+#ifndef AURORA_UVD_METADATA_ADAPTER_H_
+#define AURORA_UVD_METADATA_ADAPTER_H_
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include "rdn_uvd_h264.h"
+
+namespace aurora_uvd {
+enum class Result {
+  kOk, kInvalid, kUnsupportedFormat, kUnsupportedReference,
+  kUnsupportedSlice, kPackerRejected
+};
+struct Metadata {
+  rdn_uvd_h264_config config;
+  rdn_uvd_h264_picture picture;
+};
+
+static constexpr uint8_t kScan4[16] =
+    {0,1,4,8,5,2,3,6,9,12,13,10,7,11,14,15};
+static constexpr uint8_t kScan8[64] = {
+    0,1,8,16,9,2,3,10,17,24,32,25,18,11,4,5,
+    12,19,26,33,40,48,41,34,27,20,13,6,7,14,21,28,
+    35,42,49,56,57,50,43,36,29,22,15,23,30,37,44,51,
+    58,59,52,45,38,31,39,46,53,60,61,54,47,55,62,63};
+
+// Inputs use Chromium's parsed/resolved fields. No input or output changes on failure.
+template<class Sps>
+Result MapConfig(const Sps& s, rdn_uvd_h264_config* output) {
+  if (!output) return Result::kInvalid;
+  if (s.pic_width_in_mbs_minus1 < 3 || s.pic_width_in_mbs_minus1 >= 120 ||
+      s.pic_height_in_map_units_minus1 < 3 ||
+      s.pic_height_in_map_units_minus1 >= 68 ||
+      !s.frame_mbs_only_flag || s.mb_adaptive_frame_field_flag ||
+      s.separate_colour_plane_flag || s.qpprime_y_zero_transform_bypass_flag)
+    return Result::kUnsupportedFormat;
+  rdn_uvd_h264_config c = {};
+  c.version = RDN_UVD_H264_VERSION;
+  c.profile_idc = s.profile_idc;
+  c.level_idc = ((s.profile_idc == 66 || s.profile_idc == 77) &&
+                s.level_idc == 11 && s.constraint_set3_flag) ? 9 : s.level_idc;
+  c.coded_width = (s.pic_width_in_mbs_minus1 + 1) * 16;
+  c.coded_height = (s.pic_height_in_map_units_minus1 + 1) * 16;
+  c.max_num_ref_frames = s.max_num_ref_frames;
+  c.chroma_format_idc = s.chroma_format_idc;
+  c.bit_depth_luma_minus8 = s.bit_depth_luma_minus8;
+  c.bit_depth_chroma_minus8 = s.bit_depth_chroma_minus8;
+  c.frame_mbs_only_flag = s.frame_mbs_only_flag;
+  c.mb_adaptive_frame_field_flag = s.mb_adaptive_frame_field_flag;
+  rdn_uvd_h264_layout layout;
+  if (rdn_uvd_h264_layout_init(&c, RDN_UVD_H264_TARGET_LINEAR, &layout))
+    return Result::kUnsupportedFormat;
+  *output = c;
+  return Result::kOk;
+}
+
+template<class Slice>
+Result ActiveCounts(const Slice& slice, uint32_t* l0, uint32_t* l1) {
+  if (slice.slice_type < 0 || slice.slice_type > 9 ||
+      slice.slice_type % 5 > 2 || slice.field_pic_flag ||
+      slice.bottom_field_flag || slice.redundant_pic_cnt)
+    return Result::kUnsupportedSlice;
+  *l0 = *l1 = 0;
+  if (slice.slice_type % 5 != 2) {
+    if (slice.num_ref_idx_l0_active_minus1 < 0 ||
+        slice.num_ref_idx_l0_active_minus1 > 15)
+      return Result::kUnsupportedSlice;
+    *l0 = slice.num_ref_idx_l0_active_minus1;
+  }
+  if (slice.slice_type % 5 == 1) {
+    if (slice.num_ref_idx_l1_active_minus1 < 0 ||
+        slice.num_ref_idx_l1_active_minus1 > 15)
+      return Result::kUnsupportedSlice;
+    *l1 = slice.num_ref_idx_l1_active_minus1;
+  }
+  return Result::kOk;
+}
+
+// UVD has one active-count pair per message; mixed pairs need separate validation.
+template<class Slice>
+bool CompatibleSlice(const Slice& first, const Slice& next) {
+  uint32_t a0, a1, b0, b1;
+  return ActiveCounts(first, &a0, &a1) == Result::kOk &&
+         ActiveCounts(next, &b0, &b1) == Result::kOk &&
+         first.pic_parameter_set_id == next.pic_parameter_set_id &&
+         first.frame_num == next.frame_num &&
+         first.slice_type % 5 == next.slice_type % 5 &&
+         a0 == b0 && a1 == b1;
+}
+
+// Chromium applies short-term removals after decoding this picture.
+template<class Picture>
+bool ShortTermMarking(const Picture& picture, uint32_t max_frame_num) {
+  if (!picture.adaptive_ref_pic_marking_mode_flag) return true;
+  for (const auto& marking : picture.ref_pic_marking) {
+    if (marking.memory_mgmnt_control_operation == 0) return true;
+    if (marking.memory_mgmnt_control_operation != 1 ||
+        marking.difference_of_pic_nums_minus1 < 0 ||
+        static_cast<uint32_t>(marking.difference_of_pic_nums_minus1) >= max_frame_num)
+      return false;
+  }
+  return false;
+}
+
+// refs is SubmitFrameMetadata's ref_pic_listp0, not a slice's reordered L0/L1.
+template<class Sps, class Pps, class Picture, class Slice>
+Result MapPicture(const Sps& s, const Pps& p, const Picture& current,
+                  const Slice& first_slice, const Picture* const* refs,
+                  size_t ref_count, Metadata* output) {
+  if (!output || (ref_count && !refs) || ref_count > 16 ||
+      p.seq_parameter_set_id != s.seq_parameter_set_id ||
+      first_slice.pic_parameter_set_id != p.pic_parameter_set_id ||
+      first_slice.frame_num != current.frame_num ||
+      current.pic_order_cnt_type != s.pic_order_cnt_type)
+    return Result::kInvalid;
+  Metadata m = {};
+  Result status = MapConfig(s, &m.config);
+  if (status != Result::kOk) return status;
+  if (current.field != 0 || current.nonexisting || current.long_term ||
+      current.long_term_reference_flag || current.mem_mgmt_5)
+    return Result::kUnsupportedReference;
+  if (ref_count > m.config.max_num_ref_frames || p.num_slice_groups_minus1 ||
+      s.log2_max_frame_num_minus4 < 0 || s.log2_max_frame_num_minus4 > 12 ||
+      p.weighted_bipred_idc < 0 || p.weighted_bipred_idc > 2)
+    return Result::kUnsupportedFormat;
+  const uint32_t max_frame_num = 1u << (s.log2_max_frame_num_minus4 + 4);
+  if (current.frame_num < 0 || static_cast<uint32_t>(current.frame_num) >= max_frame_num)
+    return Result::kInvalid;
+  if (!ShortTermMarking(current, max_frame_num))
+    return Result::kUnsupportedReference;
+  auto& q = m.picture;
+  q.version = RDN_UVD_H264_VERSION;
+  q.sps_info_flags = (s.direct_8x8_inference_flag ? 1u : 0u) |
+                    (s.frame_mbs_only_flag ? 4u : 0u) |
+                    (s.delta_pic_order_always_zero_flag ? 8u : 0u);
+  q.pps_info_flags = (p.transform_8x8_mode_flag ? 1u : 0u) |
+                    (p.redundant_pic_cnt_present_flag ? 2u : 0u) |
+                    (p.constrained_intra_pred_flag ? 4u : 0u) |
+                    (p.deblocking_filter_control_present_flag ? 8u : 0u) |
+                    (static_cast<uint32_t>(p.weighted_bipred_idc) << 4) |
+                    (p.weighted_pred_flag ? 64u : 0u) |
+                    (p.bottom_field_pic_order_in_frame_present_flag ? 128u : 0u) |
+                    (p.entropy_coding_mode_flag ? 256u : 0u);
+  q.log2_max_frame_num_minus4 = s.log2_max_frame_num_minus4;
+  q.pic_order_cnt_type = s.pic_order_cnt_type;
+  q.log2_max_pic_order_cnt_lsb_minus4 =
+      s.pic_order_cnt_type == 0 ? s.log2_max_pic_order_cnt_lsb_minus4 : 0;
+  q.pic_init_qp_minus26 = p.pic_init_qp_minus26;
+  q.pic_init_qs_minus26 = p.pic_init_qs_minus26;
+  q.chroma_qp_index_offset = p.chroma_qp_index_offset;
+  q.second_chroma_qp_index_offset = p.second_chroma_qp_index_offset;
+  status = ActiveCounts(first_slice, &q.num_ref_idx_l0_active_minus1,
+                        &q.num_ref_idx_l1_active_minus1);
+  if (status != Result::kOk) return status;
+  q.frame_num = current.frame_num;
+  q.field_order_cnt[0] = current.top_field_order_cnt;
+  q.field_order_cnt[1] = current.bottom_field_order_cnt;
+  q.reference_count = static_cast<uint32_t>(ref_count);
+  for (size_t i = 0; i < ref_count; ++i) {
+    const Picture* ref = refs[i];
+    if (!ref || !ref->ref || ref->field != 0 || ref->nonexisting || ref->long_term)
+      return Result::kUnsupportedReference;
+    if (ref->frame_num < 0 || static_cast<uint32_t>(ref->frame_num) >= max_frame_num)
+      return Result::kInvalid;
+    for (size_t j = 0; j < i; ++j)
+      if (refs[j] == ref) return Result::kInvalid;
+    // Chromium VA -> Mesa UVD uses raw frame_num, never FrameNumWrap or DPB slot.
+    q.frame_num_list[i] = ref->frame_num;
+    q.field_order_cnt_list[i][0] = ref->top_field_order_cnt;
+    q.field_order_cnt_list[i][1] = ref->bottom_field_order_cnt;
+  }
+  const auto& scaling4 = p.pic_scaling_matrix_present_flag ?
+      p.scaling_list4x4 : s.scaling_list4x4;
+  const auto& scaling8 = p.pic_scaling_matrix_present_flag ?
+      p.scaling_list8x8 : s.scaling_list8x8;
+  for (size_t i = 0; i < 6; ++i)
+    for (size_t j = 0; j < 16; ++j)
+      q.scaling_list_4x4[i][kScan4[j]] = scaling4[i][j];
+  for (size_t i = 0; i < 2; ++i)
+    for (size_t j = 0; j < 64; ++j)
+      q.scaling_list_8x8[i][kScan8[j]] = scaling8[i][j];
+  rdn_uvd_h264_layout layout;
+  uint8_t message[RDN_UVD_H264_MESSAGE_BYTES];
+  if (rdn_uvd_h264_layout_init(&m.config, RDN_UVD_H264_TARGET_LINEAR, &layout) ||
+      rdn_uvd_h264_pack_decode(&m.config, &q, &layout, 1, 1, 1,
+                               message, sizeof(message)))
+    return Result::kPackerRejected;
+  *output = m;
+  return Result::kOk;
+}
+}  // namespace aurora_uvd
+#endif
