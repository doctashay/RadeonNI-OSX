+#ifndef AURORA_UVD_SESSION_H_
+#define AURORA_UVD_SESSION_H_
+#include <memory>
+#include "radeon_uvd_backend.h"
+
+namespace aurora_uvd {
+uint32_t ProfileBit(uint32_t profile);
+// Chromium describes an unencrypted NAL with a clear-only subsample.
+template <class Entry>
+bool ClearSubsamples(const std::vector<Entry>& entries, size_t bytes) {
+  if (entries.empty()) return true;
+  size_t remaining = bytes;
+  for (const auto& entry : entries) {
+    if (entry.cypher_bytes || entry.clear_bytes > remaining) return false;
+    remaining -= entry.clear_bytes;
+  }
+  return remaining == 0;
+}
+bool AppendSlice(const uint8_t* data, size_t bytes, size_t limit,
+                 std::vector<uint8_t>* annex_b);
+bool ValidateNV12(const LinearNV12& source, uint32_t width, uint32_t height,
+                  size_t* packed_bytes);
+// Destination must not alias source.
+bool CopyNV12(const LinearNV12& source, uint32_t width, uint32_t height,
+              uint8_t* destination, size_t capacity);
+
+class Session {
+ public:
+  explicit Session(std::unique_ptr<Backend> backend);
+  ~Session();
+  BackendStatus Query(Capabilities* actual);
+  BackendStatus Decode(const Metadata& metadata, bool idr,
+                       const std::vector<uint8_t>& annex_b, LinearNV12* output);
+  BackendStatus DecodeInto(const Metadata& metadata, bool idr,
+                           const std::vector<uint8_t>& annex_b,
+                           uint8_t* destination, size_t capacity);
+  BackendStatus Reset();
+  bool faulted() const { return faulted_; }
+
+ private:
+  BackendStatus DecodeCommon(const Metadata& metadata, bool idr,
+                             const std::vector<uint8_t>& annex_b,
+                             LinearNV12* output, uint8_t* destination,
+                             size_t capacity);
+  std::unique_ptr<Backend> backend_;
+  rdn_uvd_h264_config config_ = {};
+  bool opened_ = false;
+  bool faulted_ = false;
+};
+}  // namespace aurora_uvd
