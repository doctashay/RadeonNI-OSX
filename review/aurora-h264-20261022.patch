+#ifndef AURORA_REPLAY_VIDEO_DECODER_H_
+#define AURORA_REPLAY_VIDEO_DECODER_H_
+#include <deque>
+#include <map>
+#include <memory>
+#include "annex_b_replay.h"
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "media/base/video_decoder.h"
+#include "media/base/video_decoder_config.h"
+
+namespace media { class MediaLog; }
+
+namespace aurora_uvd {
+class ReplayVideoDecoder final : public media::VideoDecoder {
+ public:
+  using Factory = base::RepeatingCallback<std::unique_ptr<media::VideoDecoder>()>;
+  ReplayVideoDecoder(std::unique_ptr<media::VideoDecoder>, Factory software);
+  ReplayVideoDecoder(std::unique_ptr<media::VideoDecoder>, Factory software,
+                     std::unique_ptr<media::MediaLog> media_log);
+  ~ReplayVideoDecoder() override;
+  void Initialize(const media::VideoDecoderConfig&, bool, media::CdmContext*,
+                  InitCB, const OutputCB&, const media::WaitingCB&) override;
+  void Decode(scoped_refptr<media::DecoderBuffer>, DecodeCB) override;
+  void Reset(base::OnceClosure) override;
+  bool NeedsBitstreamConversion() const override { return true; }
+  int GetMaxDecodeRequests() const override { return 1; }
+  bool FramesHoldExternalResources() const override { return false; }
+  bool IsPlatformDecoder() const override {
+    return platform_decoder_;
+  }
+  media::VideoDecoderType GetDecoderType() const override;
+ private:
+  struct Entry {
+    scoped_refptr<media::DecoderBuffer> buffer;
+    base::TimeDelta timestamp, duration;
+    size_t delivered = 0, suppress = 0;
+    bool idr = false, picture = false;
+    bool field = false, bottom = false, reference = false, no_output = false;
+    int frame_num = 0, pps_id = 0;
+    int64_t paired_id = 0;
+  };
+  void Initialized(uint64_t, InitCB, media::DecoderStatus);
+  void Pump();
+  void Completed(uint64_t, int64_t, media::DecoderStatus);
+  void Output(uint64_t, scoped_refptr<media::VideoFrame>);
+  void FallBack();
+  void SoftwareReady(uint64_t, media::DecoderStatus);
+  void ResetReady(uint64_t, base::OnceClosure, media::DecoderStatus);
+  void ReinitializeAfterReset(uint64_t, base::OnceClosure);
+  void PruneCheckpoint();
+  void ReportSoftwareDecoder();
+  void Finish(media::DecoderStatus);
+  OutputCB BoundOutput();
+  std::unique_ptr<media::VideoDecoder> decoder_;
+  Factory software_factory_;
+  std::unique_ptr<media::MediaLog> media_log_;
+  const bool platform_decoder_;
+  AnnexBReplay parser_;
+  media::VideoDecoderConfig config_;
+  media::WaitingCB waiting_;
+  OutputCB output_;
+  DecodeCB pending_;
+  std::deque<ReplayAccessUnit> input_;
+  std::deque<int64_t> replay_;
+  std::map<int64_t, Entry> entries_;
+  size_t history_bytes_ = 0;
+  int64_t next_id_ = 1;
+  int64_t checkpoint_ = 0;
+  int64_t last_picture_id_ = 0;
+  uint64_t generation_ = 0;
+  bool initialized_ = false, software_ = false, replaying_ = false;
+  bool eos_ = false, low_delay_ = false, failed_ = false;
+  base::WeakPtrFactory<ReplayVideoDecoder> weak_{this};
+};
+std::unique_ptr<media::VideoDecoder> CreateWorkerFFmpegDecoder();
+}  // namespace aurora_uvd
+#endif
