+      auto memory = base::ReadOnlySharedMemoryRegion::Create(bytes);
+      if (!memory.IsValid()) return Reject(Code::kFailedToGetVideoFrame);
+      Diagnostic("submit_decode_slices", slices_);
+      media::DecoderStatus status = ToStatus(core_->session_.DecodeInto(
+          metadata_, current_->idr, bitstream_,
+          static_cast<uint8_t*>(memory.mapping.memory()), bytes));
+      Diagnostic("session_decode", static_cast<int>(status.code()));
+      if (!status.is_ok()) {
+        core_->last_error_ = status;
+        Clear();
+        return AccelStatus::kFail;
+      }
+      auto* target = static_cast<Picture*>(picture.get());
+      target->frame = SharedFrame(std::move(memory), width, height, *target);
+      Clear();
+      return target->frame ? AccelStatus::kOk : Reject(Code::kFailedToGetVideoFrame);
+    }
+    bool OutputPicture(scoped_refptr<media::H264Picture> picture) override {
+      auto* target = static_cast<Picture*>(picture.get());
+      if (!target->frame) {
+        Reject(Code::kFailedToGetVideoFrame);
+        return false;
+      }
+      target->frame->set_color_space(picture->get_colorspace().ToGfxColorSpace());
+      core_->output_.Run(target->frame);
+      return true;
+    }
+    void Reset() override {
+      Clear();
+      core_->session_.Reset();
+    }
+    AccelStatus SetStream(base::span<const uint8_t>,
+                          const media::DecryptConfig* decrypt) override {
+      return decrypt ? Reject(Code::kUnsupportedEncryptionMode) : AccelStatus::kOk;
+    }
+   private:
+    AccelStatus Reject(Code code, const char* stage = "accelerator") {
+      Diagnostic(stage, static_cast<int>(code));
+      core_->last_error_ = code;
+      return AccelStatus::kFail;
+    }
+    void Clear() {
+      current_ = nullptr;
+      refs_.clear();
+      bitstream_.clear();
+      slices_ = 0;
+    }
+    Core* const core_;
+    media::H264SPS sps_;
+    media::H264PPS pps_;
+    media::H264SliceHeader first_slice_;
+    scoped_refptr<media::H264Picture> current_;
+    media::H264Picture::Vector refs_;
+    Metadata metadata_ = {};
+    std::vector<uint8_t> bitstream_;
+    unsigned slices_ = 0;
+  };
+  Status Fail(Code code) { failed_ = true; return Status(code); }
+  Status Error() {
+    return last_error_.is_ok() ? Status(Code::kMalformedBitstream) : last_error_;
+  }
+  Session session_;
+  media::VideoDecoderConfig config_;
+  Capabilities caps_;
+  OutputCB output_;
+  base::TimeDelta timestamp_, duration_;
+  Status last_error_ = Code::kOk;
+  int32_t stream_id_ = 0;
+  bool failed_ = false;
+  std::unique_ptr<media::H264Decoder> decoder_;
+};
+
+RadeonUvdVideoDecoder::RadeonUvdVideoDecoder(std::unique_ptr<Backend> backend)
+    : initial_backend_(std::move(backend)) {}
+RadeonUvdVideoDecoder::~RadeonUvdVideoDecoder() = default;
+void RadeonUvdVideoDecoder::Initialize(
+    const media::VideoDecoderConfig& config, bool low_delay, media::CdmContext*,
+    InitCB callback, const OutputCB& output, const media::WaitingCB&) {
+  ++generation_;
+  initialized_ = false;
+  output_ = output;
+  if (!config.IsValidConfig() || low_delay ||
+      config.codec() != media::VideoCodec::kH264 || config.is_encrypted() ||
+      !ProfileId(config.profile())) {
+    if (core_) {
+      core_->AsyncCall(&Core::Reset).WithArgs(WorkerOutput()).Then(
+          base::BindOnce(&RadeonUvdVideoDecoder::Initialized,
+                         weak_factory_.GetWeakPtr(), generation_, std::move(callback),
+                         Status(Code::kUnsupportedConfig)));
+    } else {
+      std::move(callback).Run(Code::kUnsupportedConfig);
+    }
+    return;
+  }
+  if (!core_) {
+    auto worker = base::ThreadPool::CreateSingleThreadTaskRunner(
+        {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+         base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+        base::SingleThreadTaskRunnerThreadMode::DEDICATED);
+    core_ = std::make_unique<base::SequenceBound<Core>>(
+        worker, std::move(initial_backend_));
+  }
+  core_->AsyncCall(&Core::Initialize).WithArgs(config, WorkerOutput()).Then(
+      base::BindOnce(&RadeonUvdVideoDecoder::Initialized,
+                     weak_factory_.GetWeakPtr(), generation_, std::move(callback)));
+}
+void RadeonUvdVideoDecoder::Initialized(
+    uint64_t generation, InitCB callback, Status status) {
+  if (generation != generation_) return;
+  initialized_ = status.is_ok();
+  std::move(callback).Run(status);
+}
+RadeonUvdVideoDecoder::OutputCB RadeonUvdVideoDecoder::WorkerOutput() {
+  return base::BindPostTaskToCurrentDefault(base::BindRepeating(
+      &RadeonUvdVideoDecoder::Output, weak_factory_.GetWeakPtr(), generation_));
+}
+void RadeonUvdVideoDecoder::Output(
+    uint64_t generation, scoped_refptr<media::VideoFrame> frame) {
+  if (generation == generation_ && initialized_) output_.Run(std::move(frame));
+}
+void RadeonUvdVideoDecoder::Decode(
+    scoped_refptr<media::DecoderBuffer> buffer, DecodeCB callback) {
+  if (!initialized_ || !buffer || pending_decode_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), Code::kNotInitialized));
+    return;
+  }
+  pending_decode_ = std::move(callback);
+  core_->AsyncCall(&Core::Decode).WithArgs(std::move(buffer)).Then(
+      base::BindOnce(&RadeonUvdVideoDecoder::Decoded,
+                     weak_factory_.GetWeakPtr(), generation_));
+}
+void RadeonUvdVideoDecoder::Decoded(uint64_t generation, Status status) {
+  if (generation == generation_ && pending_decode_)
+    std::move(pending_decode_).Run(status);
+}
+void RadeonUvdVideoDecoder::Reset(base::OnceClosure closure) {
+  ++generation_;
+  auto alive = weak_factory_.GetWeakPtr();
+  if (pending_decode_) std::move(pending_decode_).Run(Code::kAborted);
+  if (!alive) return;
+  if (!core_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, std::move(closure));
+    return;
+  }
+  core_->AsyncCall(&Core::Reset).WithArgs(WorkerOutput()).Then(
+      base::BindOnce(
+          [](base::WeakPtr<RadeonUvdVideoDecoder> self, base::OnceClosure done) {
+            if (self) std::move(done).Run();
+          }, weak_factory_.GetWeakPtr(), std::move(closure)));
+}
