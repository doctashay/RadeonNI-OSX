+#ifndef AURORA_ANNEX_B_REPLAY_H_
+#define AURORA_ANNEX_B_REPLAY_H_
+#include <map>
+#include <memory>
+#include <vector>
+#include "base/memory/scoped_refptr.h"
+#include "media/base/decoder_buffer.h"
+#include "media/video/h264_parser.h"
+
+namespace aurora_uvd {
+struct ReplayAccessUnit {
+  scoped_refptr<media::DecoderBuffer> buffer;
+  std::vector<uint8_t> parameters;
+  bool idr = false;
+  bool picture = false;
+  bool field = false, bottom = false, reference = false;
+  int frame_num = 0, pps_id = 0;
+};
+// Complete Annex-B packets are normalized to one primary picture per buffer.
+class AnnexBReplay {
+ public:
+  bool Split(const media::DecoderBuffer&, std::vector<ReplayAccessUnit>*);
+  void Clear();
+ private:
+  bool Save(int type, int id, const media::H264NALU&);
+  std::vector<uint8_t> Parameters() const;
+  std::unique_ptr<media::H264Parser> parser_ = std::make_unique<media::H264Parser>();
+  std::map<std::pair<int, int>, std::vector<uint8_t>> parameters_;
+  size_t parameter_bytes_ = 0;
+};
+}  // namespace aurora_uvd
+#endif
