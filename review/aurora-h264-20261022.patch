+void Diagnostic(const char* stage, int value) {
+#if defined(AURORA_UVD_DIAGNOSTICS)
+  fprintf(stderr, "uvd_decoder stage=%s value=%d\n", stage, value);
+#else
+  (void)stage;
+  (void)value;
+#endif
+}
+uint32_t ProfileId(media::VideoCodecProfile p) {
+  switch (p) {
+    case media::H264PROFILE_BASELINE: return 66;
+    case media::H264PROFILE_MAIN: return 77;
+    case media::H264PROFILE_HIGH: return 100;
+    default: return 0;
+  }
+}
+Status ToStatus(BackendStatus status) {
+  return status == BackendStatus::kOk ? Status(Code::kOk) :
+         status == BackendStatus::kUnsupported ? Status(Code::kUnsupportedConfig) :
+                                               Status(Code::kPlatformDecodeFailure);
+}
+class Picture final : public media::H264Picture {
+ public:
+  base::TimeDelta timestamp, duration;
+  gfx::Size natural_size;
+  scoped_refptr<media::VideoFrame> frame;
+ private:
+  ~Picture() override = default;
+};
+scoped_refptr<media::VideoFrame> SharedFrame(base::MappedReadOnlyRegion memory,
+                                           uint32_t width, uint32_t height,
+                                           const Picture& picture) {
+  const size_t bytes = size_t(width) * height * 3 / 2;
+  if (!memory.IsValid() || memory.mapping.size() != bytes) return nullptr;
+  memory.mapping = base::WritableSharedMemoryMapping();
+  auto readonly = memory.region.Map();
+  if (!readonly.IsValid()) return nullptr;
+  const auto* data = static_cast<const uint8_t*>(readonly.memory());
+  auto frame = media::VideoFrame::WrapExternalYuvData(
+      media::PIXEL_FORMAT_NV12, gfx::Size(width, height),
+      picture.visible_rect(), picture.natural_size, width, width,
+      data, data + size_t(width) * height, picture.timestamp);
+  if (!frame) return nullptr;
+  frame->BackWithOwnedSharedMemory(std::move(memory.region), std::move(readonly));
+  frame->metadata().power_efficient = true;
+  if (picture.duration.is_positive()) frame->metadata().frame_duration = picture.duration;
+  frame->set_hdr_metadata(picture.hdr_metadata());
+  return frame;
+}
