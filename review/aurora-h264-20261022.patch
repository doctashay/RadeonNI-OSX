+#include "replay_video_decoder.h"
+#include <utility>
+#include "base/functional/bind.h"
+#include "base/task/sequenced_task_runner.h"
+#include "media/base/media_log.h"
+#include "media/base/video_frame.h"
+
+namespace aurora_uvd {
+namespace {
+using Code = media::DecoderStatus::Codes;
+constexpr size_t kHistoryBytes = 8u * 1024u * 1024u;
+constexpr size_t kHistoryPictures = 256;
+}  // namespace
+ReplayVideoDecoder::ReplayVideoDecoder(std::unique_ptr<media::VideoDecoder> hardware,
+                                       Factory software)
+    : ReplayVideoDecoder(std::move(hardware), std::move(software), nullptr) {}
+ReplayVideoDecoder::ReplayVideoDecoder(std::unique_ptr<media::VideoDecoder> hardware,
+                                       Factory software,
+                                       std::unique_ptr<media::MediaLog> media_log)
+    : decoder_(std::move(hardware)), software_factory_(std::move(software)),
+      media_log_(std::move(media_log)),
+      platform_decoder_(decoder_ && decoder_->IsPlatformDecoder()) {}
+ReplayVideoDecoder::~ReplayVideoDecoder() = default;
+media::VideoDecoderType ReplayVideoDecoder::GetDecoderType() const {
+  return decoder_ ? decoder_->GetDecoderType() : media::VideoDecoderType::kUnknown;
+}
+void ReplayVideoDecoder::Initialize(const media::VideoDecoderConfig& config,
+    bool low_delay, media::CdmContext* cdm, InitCB done, const OutputCB& output,
+    const media::WaitingCB& waiting) {
+  ++generation_;
+  initialized_ = failed_ = false;
+  input_.clear(); replay_.clear(); entries_.clear(); parser_.Clear();
+  history_bytes_ = 0;
+  next_id_ = 1;
+  checkpoint_ = last_picture_id_ = 0;
+  config_ = config; low_delay_ = low_delay; output_ = output; waiting_ = waiting;
+  eos_ = replaying_ = false;
+  if (!decoder_) { std::move(done).Run(Code::kUnsupportedConfig); return; }
+  decoder_->Initialize(config, low_delay, cdm,
+      base::BindOnce(&ReplayVideoDecoder::Initialized, weak_.GetWeakPtr(),
+                     generation_, std::move(done)), BoundOutput(), waiting);
+}
+void ReplayVideoDecoder::Initialized(uint64_t generation, InitCB done,
+                                    media::DecoderStatus status) {
+  if (generation != generation_) return;
+  initialized_ = status.is_ok();
+  if (initialized_) ReportSoftwareDecoder();
+  std::move(done).Run(status);
+}
+media::VideoDecoder::OutputCB ReplayVideoDecoder::BoundOutput() {
+  return base::BindRepeating(&ReplayVideoDecoder::Output, weak_.GetWeakPtr(), generation_);
+}
+void ReplayVideoDecoder::Decode(scoped_refptr<media::DecoderBuffer> buffer,
+                                DecodeCB done) {
+  if (!initialized_ || failed_ || pending_ || !buffer) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+        base::BindOnce(std::move(done), Code::kNotInitialized));
+    return;
+  }
+  pending_ = std::move(done);
+  eos_ = buffer->end_of_stream();
+  if (!eos_) {
+    std::vector<ReplayAccessUnit> units;
+    if (!parser_.Split(*buffer, &units)) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+          base::BindOnce(&ReplayVideoDecoder::Finish, weak_.GetWeakPtr(),
+                         media::DecoderStatus(Code::kMalformedBitstream)));
+      return;
+    }
+    for (auto& unit : units) input_.push_back(std::move(unit));
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+      base::BindOnce(&ReplayVideoDecoder::Pump, weak_.GetWeakPtr()));
+}
+void ReplayVideoDecoder::Pump() {
+  if (!pending_) return;
+  if (!replay_.empty()) {
+    int64_t id = replay_.front();
+    replay_.pop_front();
+    decoder_->Decode(entries_.at(id).buffer,
+        base::BindOnce(&ReplayVideoDecoder::Completed, weak_.GetWeakPtr(), generation_, id));
+    return;
+  }
+  if (replaying_) {
+    replaying_ = false;
+    for (auto it = entries_.begin(); it != entries_.end();) {
+      if ((it->second.delivered && !it->second.suppress) || !it->second.picture ||
+          it->second.no_output)
+        it = entries_.erase(it);
+      else { it->second.buffer = nullptr; ++it; }
+    }
+    history_bytes_ = 0;
+  }
+  if (input_.empty()) {
+    if (eos_) {
+      eos_ = false;
+      decoder_->Decode(media::DecoderBuffer::CreateEOSBuffer(),
+          base::BindOnce(&ReplayVideoDecoder::Completed, weak_.GetWeakPtr(), generation_, int64_t(0)));
+    } else Finish(Code::kOk);
+    return;
+  }
+  auto& unit = input_.front();
+  const size_t bytes_needed = unit.buffer->data_size() + unit.parameters.size();
+  if (!software_ && (entries_.size() >= kHistoryPictures ||
+      bytes_needed > kHistoryBytes - history_bytes_)) {
+    FallBack();
+    return;
+  }
+  if (entries_.size() >= 512 || next_id_ == INT64_MAX) {
+    Finish(Code::kUnsupportedConfig);
+    return;
+  }
+  int64_t id = next_id_++;
+  Entry entry;
+  entry.timestamp = unit.buffer->timestamp();
+  entry.duration = unit.buffer->duration();
+  entry.buffer = unit.buffer;
+  // An individual IDR field is not an independently replayable checkpoint.
+  entry.idr = unit.idr && !unit.field; entry.picture = unit.picture;
+  entry.field = unit.field; entry.bottom = unit.bottom;
+  entry.reference = unit.reference; entry.frame_num = unit.frame_num;
+  entry.pps_id = unit.pps_id;
+  auto previous = entries_.find(last_picture_id_);
+  if (entry.picture) last_picture_id_ = id;
+  if (entry.field && !unit.idr && previous != entries_.end()) {
+    auto& first = previous->second;
+    if (first.field && !first.paired_id && !first.delivered && !first.no_output &&
+        first.bottom != entry.bottom && first.frame_num == entry.frame_num &&
+        first.pps_id == entry.pps_id && first.reference == entry.reference) {
+      first.paired_id = id;
+      entry.paired_id = previous->first;
+    }
+  }
+  if (!unit.parameters.empty()) {
+    auto bytes = std::move(unit.parameters);
+    bytes.insert(bytes.end(), entry.buffer->data(), entry.buffer->data() + entry.buffer->data_size());
+    entry.buffer = media::DecoderBuffer::CopyFrom(bytes.data(), bytes.size());
+    entry.buffer->set_duration(entry.duration);
+    entry.buffer->set_is_key_frame(true);
+  }
+  entry.buffer->set_timestamp(base::Microseconds(id));
+  auto tagged = entry.buffer;
+  if (!software_) history_bytes_ += tagged->data_size();
+  entries_.emplace(id, std::move(entry));
+  input_.pop_front();
+  decoder_->Decode(std::move(tagged),
+      base::BindOnce(&ReplayVideoDecoder::Completed, weak_.GetWeakPtr(), generation_, id));
+}
+void ReplayVideoDecoder::Completed(uint64_t generation, int64_t id,
+                                  media::DecoderStatus status) {
+  if (generation != generation_ || !pending_) return;
+  if (!status.is_ok()) {
+    if (!software_ && status.code() != Code::kAborted) {
+      if (!id) eos_ = true;
+      FallBack(); return;
+    }
+    Finish(status); return;
+  }
+  auto found = entries_.find(id);
+  if (!software_ && found != entries_.end() && found->second.idr) {
+    checkpoint_ = id;
+    PruneCheckpoint();
+  } else if (software_ && !replaying_ && found != entries_.end()) {
+    found->second.buffer = nullptr;
+    if (!found->second.picture || found->second.delivered || found->second.no_output)
+      entries_.erase(found);
+  }
+  Pump();
+}
+void ReplayVideoDecoder::PruneCheckpoint() {
+  if (software_ || !checkpoint_) return;
+  auto checkpoint = entries_.find(checkpoint_);
+  if (checkpoint == entries_.end()) return;
+  // Do not retire replay IDs before delayed pre-IDR output reaches this sequence.
+  for (auto it = entries_.begin(); it != checkpoint; ++it)
+    if (it->second.picture && !it->second.delivered && !it->second.no_output) return;
+  for (auto it = entries_.begin(); it != checkpoint;) {
+    history_bytes_ -= it->second.buffer->data_size();
+    it = entries_.erase(it);
+  }
+}
+void ReplayVideoDecoder::Output(uint64_t generation,
+                               scoped_refptr<media::VideoFrame> frame) {
+  if (generation != generation_ || !initialized_ || failed_) return;
+  auto found = entries_.find(frame->timestamp().InMicroseconds());
+  if (found == entries_.end()) { failed_ = true; return; }
+  auto& entry = found->second;
+  // FFmpeg emits one complete frame for two complementary field packets.
+  auto partner = entries_.find(entry.paired_id);
+  if (partner != entries_.end()) {
+    partner->second.no_output = true;
+    if (software_ && !replaying_ && !partner->second.buffer) entries_.erase(partner);
+  }
+  if (entry.suppress) {
+    --entry.suppress;
+    if (!replaying_ && !entry.buffer && !entry.suppress) entries_.erase(found);
+    return;
+  }
+  ++entry.delivered;
+  frame->set_timestamp(entry.timestamp);
+  if (entry.duration.is_positive()) frame->metadata().frame_duration = entry.duration;
+  if (software_ && !replaying_ && !entry.buffer) entries_.erase(found);
+  PruneCheckpoint();
+  output_.Run(std::move(frame));
+}
+void ReplayVideoDecoder::FallBack() {
+  // Destruction retires hardware asynchronously; quarantined storage stays owned.
+  ++generation_;
+  decoder_.reset();
+  decoder_ = software_factory_.Run();
+  software_ = replaying_ = true;
+  replay_.clear();
+  for (auto& item : entries_) {
+    item.second.suppress = item.second.delivered;
+    replay_.push_back(item.first);
+  }
+  if (!decoder_) { initialized_ = false; Finish(Code::kUnsupportedConfig); return; }
+  decoder_->Initialize(config_, low_delay_, nullptr,
+      base::BindOnce(&ReplayVideoDecoder::SoftwareReady, weak_.GetWeakPtr(), generation_),
+      BoundOutput(), waiting_);
+}
+void ReplayVideoDecoder::SoftwareReady(uint64_t generation, media::DecoderStatus status) {
+  if (generation != generation_ || !pending_) return;
+  if (!status.is_ok()) { Finish(status); return; }
+  ReportSoftwareDecoder();
+  Pump();
+}
+void ReplayVideoDecoder::ReportSoftwareDecoder() {
+  if (software_ && media_log_ && decoder_ &&
+      decoder_->GetDecoderType() == media::VideoDecoderType::kFFmpeg) {
+    media_log_->SetProperty<media::MediaLogProperty::kVideoDecoderName>(
+        media::VideoDecoderType::kFFmpeg);
+    media_log_->SetProperty<media::MediaLogProperty::kIsPlatformVideoDecoder>(false);
+  }
+}
+void ReplayVideoDecoder::Finish(media::DecoderStatus status) {
+  if (!pending_) return;
+  if (failed_ && status.is_ok()) status = Code::kFailed;
+  failed_ = !status.is_ok();
+  std::move(pending_).Run(status);
+}
+void ReplayVideoDecoder::Reset(base::OnceClosure done) {
+  ++generation_;
+  auto alive = weak_.GetWeakPtr();
+  if (pending_) std::move(pending_).Run(Code::kAborted);
+  if (!alive) return;
+  input_.clear(); replay_.clear(); entries_.clear();
+  history_bytes_ = 0; eos_ = replaying_ = failed_ = false;
+  checkpoint_ = last_picture_id_ = 0;
+  if (!decoder_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, std::move(done));
+    return;
+  }
+  decoder_->Reset(base::BindOnce(&ReplayVideoDecoder::ReinitializeAfterReset,
+      weak_.GetWeakPtr(), generation_, std::move(done)));
+}
+void ReplayVideoDecoder::ReinitializeAfterReset(uint64_t generation,
+                                               base::OnceClosure done) {
+  if (generation != generation_) return;
+  // Rebind callbacks after cancellation; parameter state survives seek.
+  decoder_->Initialize(config_, low_delay_, nullptr,
+      base::BindOnce(&ReplayVideoDecoder::ResetReady, weak_.GetWeakPtr(),
+                     generation_, std::move(done)), BoundOutput(), waiting_);
+}
+void ReplayVideoDecoder::ResetReady(uint64_t generation, base::OnceClosure done,
+                                   media::DecoderStatus status) {
+  if (generation != generation_) return;
+  if (!status.is_ok() && !software_) {
+    decoder_.reset();
+    decoder_ = software_factory_.Run();
+    software_ = true;
+    if (decoder_) { ReinitializeAfterReset(generation, std::move(done)); return; }
+  }
+  initialized_ = status.is_ok();
+  if (initialized_) ReportSoftwareDecoder();
+  std::move(done).Run();
+}
+}  // namespace aurora_uvd
