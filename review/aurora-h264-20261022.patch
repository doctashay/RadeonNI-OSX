+#include "radeon_uvd_session.h"
+#include <algorithm>
+#include <string.h>
+#include <utility>
+
+namespace aurora_uvd {
+uint32_t ProfileBit(uint32_t profile) {
+  return profile == 66 ? 1u : profile == 77 ? 2u : profile == 100 ? 4u : 0u;
+}
+bool AppendSlice(const uint8_t* data, size_t bytes, size_t limit,
+                 std::vector<uint8_t>* output) {
+  if (!output || !data || !bytes || (data[0] & 0x80) ||
+      ((data[0] & 31) != 1 && (data[0] & 31) != 5) ||
+      limit > RDN_UVD_H264_MAX_BITSTREAM_BYTES || output->size() > limit ||
+      limit - output->size() < 4 || bytes > limit - output->size() - 4)
+    return false;
+  const uint8_t prefix[] = {0, 0, 0, 1};
+  output->insert(output->end(), prefix, prefix + 4);
+  output->insert(output->end(), data, data + bytes);
+  return true;
+}
+bool ValidateNV12(const LinearNV12& s, uint32_t width, uint32_t height,
+                  size_t* packed_bytes) {
+  if (!packed_bytes || !width || !height || (width & 1) || (height & 1) ||
+      width > RDN_UVD_H264_MAX_WIDTH || height > RDN_UVD_H264_MAX_HEIGHT ||
+      s.width != width || s.height != height ||
+      s.y_stride < width || s.uv_stride < width ||
+      s.bytes.size() > 64u * 1024u * 1024u ||
+      s.y_offset > s.bytes.size() || s.uv_offset > s.bytes.size())
+    return false;
+  const uint64_t y_end = uint64_t(s.y_offset) + uint64_t(s.y_stride) * (height - 1) + width;
+  const uint64_t uv_end = uint64_t(s.uv_offset) + uint64_t(s.uv_stride) * (height / 2 - 1) + width;
+  if (y_end > s.bytes.size() || uv_end > s.bytes.size() ||
+      !(y_end <= s.uv_offset || uv_end <= s.y_offset))
+    return false;
+  *packed_bytes = size_t(width) * height * 3 / 2;
+  return true;
+}
+bool CopyNV12(const LinearNV12& s, uint32_t width, uint32_t height,
+              uint8_t* output, size_t capacity) {
+  size_t packed;
+  if (!output || !ValidateNV12(s, width, height, &packed) || capacity < packed)
+    return false;
+  for (uint32_t row = 0; row < height; ++row)
+    memcpy(output + size_t(row) * width,
+           s.bytes.data() + s.y_offset + size_t(row) * s.y_stride, width);
+  output += size_t(width) * height;
+  for (uint32_t row = 0; row < height / 2; ++row)
+    memcpy(output + size_t(row) * width,
+           s.bytes.data() + s.uv_offset + size_t(row) * s.uv_stride, width);
+  return true;
+}
+namespace {
+bool ValidDestination(const Metadata& metadata, uint8_t* destination, size_t capacity) {
+  const auto& c = metadata.config;
+  return destination && c.coded_width && c.coded_height &&
+      !(c.coded_width & 1) && !(c.coded_height & 1) &&
+      c.coded_width <= 1920 && c.coded_height <= 1088 &&
+      capacity == uint64_t(c.coded_width) * c.coded_height * 3 / 2 &&
+      reinterpret_cast<uintptr_t>(destination) <= UINTPTR_MAX - capacity;
+}
+}
+BackendStatus Backend::DecodeInto(const Metadata& metadata,
+                                  const std::vector<uint8_t>& bytes,
+                                  uint8_t* destination, size_t capacity) {
+  if (!ValidDestination(metadata, destination, capacity)) return BackendStatus::kFailure;
+  LinearNV12 pixels;
+  const auto status = Decode(metadata, bytes, &pixels);
+  if (status != BackendStatus::kOk) return status;
+  return CopyNV12(pixels, metadata.config.coded_width, metadata.config.coded_height,
+                  destination, capacity) ? BackendStatus::kOk : BackendStatus::kFailure;
+}
+Session::Session(std::unique_ptr<Backend> backend) : backend_(std::move(backend)) {}
+Session::~Session() { Reset(); }
+BackendStatus Session::Query(Capabilities* actual) {
+  if (!backend_ || faulted_ || !actual) return BackendStatus::kFailure;
+  Capabilities candidate;
+  BackendStatus status = backend_->Query(&candidate);
+  if (status != BackendStatus::kOk) return status;
+  if (!candidate.ready || !(candidate.profile_mask & 7) ||
+      (candidate.profile_mask & ~7u) || !candidate.max_width ||
+      !candidate.max_height || !candidate.max_bitstream_bytes ||
+      candidate.max_width > RDN_UVD_H264_MAX_WIDTH ||
+      candidate.max_height > RDN_UVD_H264_MAX_HEIGHT ||
+      candidate.max_bitstream_bytes > RDN_UVD_H264_MAX_BITSTREAM_BYTES)
+    return BackendStatus::kUnsupported;
+  *actual = candidate;
+  return BackendStatus::kOk;
+}
+BackendStatus Session::Reset() {
+  if (opened_) {
+    opened_ = false;
+    BackendStatus status = backend_->Destroy();
+    if (status != BackendStatus::kOk) {
+      faulted_ = true;
+      return status;
+    }
+  }
+  return faulted_ ? BackendStatus::kFailure : BackendStatus::kOk;
+}
+BackendStatus Session::Decode(const Metadata& metadata, bool idr,
+                               const std::vector<uint8_t>& bytes, LinearNV12* output) {
+  if (!output) return BackendStatus::kFailure;
+  return DecodeCommon(metadata, idr, bytes, output, nullptr, 0);
+}
+BackendStatus Session::DecodeInto(const Metadata& metadata, bool idr,
+                                  const std::vector<uint8_t>& bytes,
+                                  uint8_t* destination, size_t capacity) {
+  if (!ValidDestination(metadata, destination, capacity)) return BackendStatus::kFailure;
+  return DecodeCommon(metadata, idr, bytes, nullptr, destination, capacity);
+}
+BackendStatus Session::DecodeCommon(const Metadata& metadata, bool idr,
+                                    const std::vector<uint8_t>& bytes,
+                                    LinearNV12* output, uint8_t* destination,
+                                    size_t capacity) {
+  if (faulted_ || bytes.empty()) return BackendStatus::kFailure;
+  Capabilities caps;
+  BackendStatus status = Query(&caps);
+  if (status != BackendStatus::kOk) return status;
+  const auto& c = metadata.config;
+  rdn_uvd_h264_layout layout;
+  uint8_t message[RDN_UVD_H264_MESSAGE_BYTES];
+  if (!(caps.profile_mask & ProfileBit(c.profile_idc)) ||
+      c.coded_width > caps.max_width || c.coded_height > caps.max_height ||
+      bytes.size() > caps.max_bitstream_bytes ||
+      rdn_uvd_h264_layout_init(&c, RDN_UVD_H264_TARGET_LINEAR, &layout) ||
+      rdn_uvd_h264_pack_decode(&c, &metadata.picture, &layout, 1, 1,
+                              static_cast<uint32_t>(bytes.size()), message, sizeof(message)))
+    return BackendStatus::kUnsupported;
+  // A changed firmware DPB cannot retain references from the previous session.
+  const bool changed = !opened_ || memcmp(&config_, &c, sizeof(c)) != 0;
+  if (changed) {
+    if (!idr || metadata.picture.reference_count) return BackendStatus::kUnsupported;
+    status = Reset();
+    if (status != BackendStatus::kOk) return status;
+    status = backend_->Create(c);
+    if (status != BackendStatus::kOk) {
+      // Create owns cleanup for partial allocation/submission; uncertain failure is terminal.
+      faulted_ = status != BackendStatus::kUnsupported;
+      return status;
+    }
+    opened_ = true;
+    config_ = c;
+  }
+  if (destination) {
+    status = backend_->DecodeInto(metadata, bytes, destination, capacity);
+    if (status != BackendStatus::kOk) faulted_ = true;
+    return status;
+  }
+  LinearNV12 candidate;
+  status = backend_->Decode(metadata, bytes, &candidate);
+  size_t packed;
+  if (status != BackendStatus::kOk ||
+      !ValidateNV12(candidate, c.coded_width, c.coded_height, &packed)) {
+    faulted_ = true;
+    return status == BackendStatus::kOk ? BackendStatus::kFailure : status;
+  }
+  *output = std::move(candidate);
+  return BackendStatus::kOk;
+}
+}  // namespace aurora_uvd
