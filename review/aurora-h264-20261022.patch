+void TraceSoftwareLayer(CALayer* layer, const char* phase,
+                        CGContextRef context = nullptr) {
+  bool enabled = false;
+  TRACE_EVENT_CATEGORY_GROUP_ENABLED("gpu", &enabled);
+  if (!enabled)
+    return;
+  std::string state(phase);
+  for (CALayer* current = layer; current; current = [current superlayer]) {
+    const CGRect bounds = [current bounds];
+    const CGPoint position = [current position];
+    const CGPoint anchor = [current anchorPoint];
+    base::StringAppendF(&state,
+        " layer=%p bounds=%.1f,%.1f,%.1f,%.1f pos=%.1f,%.1f anchor=%.1f,%.1f"
+        " opacity=%.3f hidden=%d masks=%d",
+        current, bounds.origin.x, bounds.origin.y, bounds.size.width,
+        bounds.size.height, position.x, position.y, anchor.x, anchor.y,
+        static_cast<double>([current opacity]), !![current isHidden],
+        !![current masksToBounds]);
+    if (state.size() > 2048)
+      break;
+  }
+  if (context) {
+    const CGRect clip = CGContextGetClipBoundingBox(context);
+    const CGAffineTransform ctm = CGContextGetCTM(context);
+    base::StringAppendF(&state, " clip=%.1f,%.1f,%.1f,%.1f"
+        " ctm=%.2f,%.2f,%.2f,%.2f,%.2f,%.2f",
+        clip.origin.x, clip.origin.y, clip.size.width, clip.size.height,
+        ctm.a, ctm.b, ctm.c, ctm.d, ctm.tx, ctm.ty);
+  }
+  TRACE_EVENT_INSTANT2("gpu", "LeopardPresentation.CGLayerState",
+                      TRACE_EVENT_SCOPE_THREAD,
+                      "layer", reinterpret_cast<uintptr_t>(layer), "state", state);
+}
+
+void TraceSoftwarePixels(CALayer* layer, const void* address,
+                         size_t pixels, bool is_argb, bool bottom_up) {
+  bool enabled = false;
+  TRACE_EVENT_CATEGORY_GROUP_ENABLED("gpu", &enabled);
+  if (!enabled || !pixels)
+    return;
+  const size_t step = 1 + (pixels - 1) / 262144;
+  const auto* bytes = static_cast<const uint8_t*>(address);
+  size_t samples = 0, opaque = 0, transparent = 0, visible_nonwhite = 0;
+  for (size_t i = 0; i < pixels; i += step) {
+    const uint8_t* pixel = bytes + i * 4;
+    const uint8_t alpha = pixel[is_argb ? 0 : 3];
+    const uint8_t* rgb = pixel + (is_argb ? 1 : 0);
+    ++samples;
+    opaque += alpha == 255;
+    transparent += alpha == 0;
+    visible_nonwhite += alpha && (rgb[0] != 255 || rgb[1] != 255 || rgb[2] != 255);
+  }
+  const std::string stats = base::StringPrintf(
+      "pixels=%zu samples=%zu step=%zu opaque=%zu transparent=%zu"
+      " visible_nonwhite=%zu argb=%d bottom_up=%d first=%02x%02x%02x%02x",
+      pixels, samples, step, opaque, transparent, visible_nonwhite, is_argb,
+      bottom_up, bytes[0], bytes[1], bytes[2], bytes[3]);
+  TRACE_EVENT_INSTANT2("gpu", "LeopardPresentation.CGSourcePixels",
+                      TRACE_EVENT_SCOPE_THREAD,
+                      "layer", reinterpret_cast<uintptr_t>(layer), "stats", stats);
 }
 
