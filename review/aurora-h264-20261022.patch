+#ifndef AURORA_UVD_BACKEND_H_
+#define AURORA_UVD_BACKEND_H_
+#include <stdint.h>
+#include <stddef.h>
+#include <vector>
+#include "uvd_metadata_adapter.h"
+
+namespace aurora_uvd {
+enum class BackendStatus { kOk, kUnsupported, kFailure, kTimeout };
+struct Capabilities {
+  bool ready = false;
+  uint32_t profile_mask = 0;  // Baseline=1, Main=2, High=4; not a wire format.
+  uint32_t max_width = 0, max_height = 0, max_bitstream_bytes = 0;
+};
+struct LinearNV12 {
+  uint32_t width = 0, height = 0, y_stride = 0, uv_stride = 0;
+  size_t y_offset = 0, uv_offset = 0;
+  std::vector<uint8_t> bytes;
+};
+
+// All calls and destruction run on the decoder worker. No GPU pointers escape.
+class Backend {
+ public:
+  virtual ~Backend() = default;
+  virtual BackendStatus Query(Capabilities* actual) = 0;
+  virtual BackendStatus Create(const rdn_uvd_h264_config& config) = 0;
+  virtual BackendStatus Decode(const Metadata& metadata,
+                               const std::vector<uint8_t>& annex_b,
+                               LinearNV12* completed_copy) = 0;
+  // Destination is caller-owned compact NV12; it is never retained.
+  virtual BackendStatus DecodeInto(const Metadata& metadata,
+                                   const std::vector<uint8_t>& annex_b,
+                                   uint8_t* destination, size_t capacity);
+  // Failure must retain/quarantine uncertain GPU storage, including on destruction.
+  virtual BackendStatus Destroy() = 0;
+};
+}  // namespace aurora_uvd
+#endif
