+#include "radeon_uvd_iokit_backend.h"
+#include "radeon_uvd_wire_validation.h"
+#include <IOKit/IOKitLib.h>
+#include <mach/mach.h>
+#include <string.h>
+#include <utility>
+
+namespace aurora_uvd {
+namespace {
+static_assert(sizeof(rdn_video_query) == 128);
+static_assert(sizeof(rdn_video_create) == 96);
+static_assert(sizeof(rdn_video_session) == 128);
+static_assert(sizeof(rdn_video_decode) == 548);
+static_assert(sizeof(rdn_video_output) == 128);
+static_assert(sizeof(rdn_video_release) == 32);
+static_assert(sizeof(rdn_video_destroy) == 32);
+
+BackendStatus Status(kern_return_t result) {
+  if (result == KERN_SUCCESS) return BackendStatus::kOk;
+  if (result == kIOReturnTimeout) return BackendStatus::kTimeout;
+  if (result == kIOReturnUnsupported || result == kIOReturnNotReady ||
+      result == kIOReturnExclusiveAccess || result == kIOReturnBusy ||
+      result == kIOReturnNotPrivileged)
+    return BackendStatus::kUnsupported;
+  return BackendStatus::kFailure;
+}
+
+class IOKitBackend final : public Backend {
+ public:
+  explicit IOKitBackend(bool validation) : validation_(validation) {}
+  ~IOKitBackend() override { Destroy(); }
+
+  BackendStatus Query(Capabilities* actual) override {
+    if (!actual) return BackendStatus::kFailure;
+    *actual = {};
+    if (!connection_) {
+      io_service_t service = IOServiceGetMatchingService(kIOMasterPortDefault,
+          IOServiceMatching("RadeonNIAccel"));
+      if (!service) return BackendStatus::kUnsupported;
+      kern_return_t result = IOServiceOpen(service, mach_task_self(),
+          RDN_VIDEO_UC_TYPE, &connection_);
+      IOObjectRelease(service);
+      if (result) return Status(result);
+    }
+    rdn_video_query response = {};
+    size_t bytes = sizeof(response);
+    kern_return_t result = IOConnectCallStructMethod(connection_, RDN_VIDEO_QUERY,
+        nullptr, 0, &response, &bytes);
+    if (result) return Status(result);
+    if (!ValidHeader(response, bytes) || (response.flags & ~15u))
+      return BackendStatus::kFailure;
+    const uint32_t allowed = validation_ ? RDN_VIDEO_CAP_VALIDATION :
+                                          RDN_VIDEO_CAP_PRODUCTION;
+    if (!(response.flags & RDN_VIDEO_CAP_READY) || !(response.flags & allowed) ||
+        ((response.flags & RDN_VIDEO_CAP_BUSY) && !created_))
+      return BackendStatus::kUnsupported;
+    if (!response.max_width || response.max_width > 1920 ||
+        !response.max_height || response.max_height > 1088 ||
+        !response.profile_mask || (response.profile_mask & ~7u) ||
+        !response.max_upload_bytes ||
+        response.max_upload_bytes > RDN_VIDEO_MAX_UPLOAD_BYTES ||
+        response.max_sessions != 1 || response.max_inflight != 1 ||
+        response.output_slots != RDN_VIDEO_OUTPUT_SLOTS)
+      return BackendStatus::kFailure;
+    actual->ready = true;
+    actual->profile_mask = response.profile_mask;
+    actual->max_width = response.max_width;
+    actual->max_height = response.max_height;
+    actual->max_bitstream_bytes = response.max_upload_bytes;
+    return BackendStatus::kOk;
+  }
+
+  BackendStatus Create(const rdn_uvd_h264_config& config) override {
+    if (created_) return BackendStatus::kFailure;
+    Capabilities caps;
+    BackendStatus status = Query(&caps);
+    if (status != BackendStatus::kOk) return status;
+    rdn_video_create request = {};
+    request.version = RDN_VIDEO_API_VERSION;
+    request.bytes = sizeof(request);
+    request.config = config;
+    request.flags = validation_ ? RDN_VIDEO_CREATE_VALIDATION : 0;
+    size_t bytes = sizeof(session_);
+    kern_return_t result = IOConnectCallStructMethod(connection_, RDN_VIDEO_CREATE,
+        &request, sizeof(request), &session_, &bytes);
+    if (result) return Fail(Status(result));
+    created_ = true;
+    if (!ValidSession(session_, bytes, config)) return Fail(BackendStatus::kFailure);
+    config_ = config;
+    if (!Map(0, RDN_VIDEO_MEMORY_UPLOAD, session_.upload_bytes, false) ||
+        !Map(1, RDN_VIDEO_MEMORY_OUTPUT0, session_.output_bytes, true) ||
+        !Map(2, RDN_VIDEO_MEMORY_OUTPUT1, session_.output_bytes, true))
+      return Fail(BackendStatus::kFailure);
+    next_request_ = next_output_ = 1;
+    return BackendStatus::kOk;
+  }
+
+  BackendStatus Decode(const Metadata& metadata,
+                       const std::vector<uint8_t>& annex_b,
+                       LinearNV12* completed_copy) override {
+    if (!completed_copy) return BackendStatus::kFailure;
+    return DecodeFrame(metadata, annex_b, completed_copy, nullptr, 0);
+  }
+  BackendStatus DecodeInto(const Metadata& metadata,
+                           const std::vector<uint8_t>& annex_b,
+                           uint8_t* destination, size_t capacity) override {
+    const auto& c = metadata.config;
+    const uintptr_t start = reinterpret_cast<uintptr_t>(destination);
+    if (!destination || !c.coded_width || !c.coded_height ||
+        (c.coded_width & 1) || (c.coded_height & 1) ||
+        c.coded_width > 1920 || c.coded_height > 1088 ||
+        capacity != uint64_t(c.coded_width) * c.coded_height * 3 / 2 ||
+        start > UINTPTR_MAX - capacity)
+      return BackendStatus::kFailure;
+    for (const auto& map : maps_)
+      if (map.address && start < map.address + map.bytes &&
+          map.address < start + capacity)
+        return BackendStatus::kFailure;
+    return DecodeFrame(metadata, annex_b, nullptr, destination, capacity);
+  }
+  BackendStatus DecodeFrame(const Metadata& metadata,
+                            const std::vector<uint8_t>& annex_b,
+                            LinearNV12* completed_copy, uint8_t* destination,
+                            size_t capacity) {
+    if (!created_ || annex_b.empty() ||
+        annex_b.size() > session_.upload_bytes ||
+        next_request_ == UINT32_MAX || next_output_ == UINT32_MAX ||
+        memcmp(&metadata.config, &config_, sizeof(config_)))
+      return BackendStatus::kFailure;
+    rdn_video_decode request = {};
+    request.version = RDN_VIDEO_API_VERSION;
+    request.bytes = sizeof(request);
+    request.session = session_.session;
+    request.request_sequence = next_request_;
+    request.bitstream_bytes = static_cast<uint32_t>(annex_b.size());
+    request.picture = metadata.picture;
+    memcpy(reinterpret_cast<void*>(maps_[0].address), annex_b.data(), annex_b.size());
+    rdn_video_output response = {};
+    size_t bytes = sizeof(response);
+    kern_return_t result = IOConnectCallStructMethod(connection_, RDN_VIDEO_DECODE,
+        &request, sizeof(request), &response, &bytes);
+    if (result) return Fail(Status(result));
+    if (!ValidOutput(response, bytes, session_, next_request_, next_output_))
+      return Fail(BackendStatus::kFailure);
+    LinearNV12 copy;
+    const auto* source = reinterpret_cast<const uint8_t*>(maps_[1 + response.slot].address);
+    if (destination) {
+      const size_t y_bytes = size_t(response.coded_width) * response.coded_height;
+      if (response.y_offset == 0 && response.uv_offset == y_bytes &&
+          response.y_stride == response.coded_width &&
+          response.uv_stride == response.coded_width) {
+        memcpy(destination, source, capacity);
+      } else {
+        for (uint32_t y = 0; y < response.coded_height; ++y)
+          memcpy(destination + size_t(y) * response.coded_width,
+                 source + response.y_offset + size_t(y) * response.y_stride,
+                 response.coded_width);
+        for (uint32_t y = 0; y < response.coded_height / 2; ++y)
+          memcpy(destination + y_bytes + size_t(y) * response.coded_width,
+                 source + response.uv_offset + size_t(y) * response.uv_stride,
+                 response.coded_width);
+      }
+    } else {
+      copy.width = response.coded_width;
+      copy.height = response.coded_height;
+      copy.y_stride = response.y_stride;
+      copy.uv_stride = response.uv_stride;
+      copy.y_offset = response.y_offset;
+      copy.uv_offset = response.uv_offset;
+      copy.bytes.resize(response.output_bytes);
+      memcpy(copy.bytes.data(), source, copy.bytes.size());
+    }
+    rdn_video_release release = {};
+    release.version = RDN_VIDEO_API_VERSION;
+    release.bytes = sizeof(release);
+    release.session = response.session;
+    release.output_sequence = response.output_sequence;
+    release.slot = response.slot;
+    size_t no_output = 0;
+    result = IOConnectCallStructMethod(connection_, RDN_VIDEO_RELEASE,
+        &release, sizeof(release), nullptr, &no_output);
+    if (result || no_output) return Fail(result ? Status(result) : BackendStatus::kFailure);
+    ++next_request_;
+    ++next_output_;
+    if (completed_copy) *completed_copy = std::move(copy);
+    return BackendStatus::kOk;
+  }
+
+  BackendStatus Destroy() override {
+    kern_return_t result = KERN_SUCCESS;
+    // Leopard resolves memory type through the live user-client session.
+    for (auto& map : maps_) {
+      if (connection_ && map.address) {
+        const kern_return_t unmapped = IOConnectUnmapMemory(
+            connection_, map.type, mach_task_self(), map.address);
+        if (!result) result = unmapped;
+      }
+      map = {};
+    }
+    if (connection_ && created_ && (session_.session.high || session_.session.low)) {
+      rdn_video_destroy request = {};
+      request.version = RDN_VIDEO_API_VERSION;
+      request.bytes = sizeof(request);
+      request.session = session_.session;
+      size_t no_output = 0;
