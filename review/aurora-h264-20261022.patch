+class RadeonUvdVideoDecoder::Core {
+ public:
+  explicit Core(std::unique_ptr<Backend> backend) : session_(std::move(backend)) {}
+  ~Core() {
+    decoder_.reset();
+    session_.Reset();
+  }
+  Status Initialize(media::VideoDecoderConfig config, OutputCB output) {
+    decoder_.reset();
+    Status status = ToStatus(session_.Reset());
+    if (!status.is_ok()) return status;
+    output_ = std::move(output);
+    config_ = std::move(config);
+    status = ToStatus(session_.Query(&caps_));
+    const auto size = config_.coded_size();
+    if (!status.is_ok()) return status;
+    if (!(caps_.profile_mask & ProfileBit(ProfileId(config_.profile()))) ||
+        size.width() < 64 || size.height() < 64 ||
+        size.width() > static_cast<int>(caps_.max_width) ||
+        size.height() > static_cast<int>(caps_.max_height))
+      return Code::kUnsupportedConfig;
+    failed_ = false;
+    last_error_ = Code::kOk;
+    stream_id_ = 0;
+    decoder_ = std::make_unique<media::H264Decoder>(
+        std::make_unique<Accelerator>(this), config_.profile(),
+        config_.color_space_info());
+    return Code::kOk;
+  }
+  Status Decode(scoped_refptr<media::DecoderBuffer> buffer) {
+    if (!decoder_) return Code::kNotInitialized;
+    if (failed_ || session_.faulted()) return Code::kPlatformDecodeFailure;
+    last_error_ = Code::kOk;
+    if (buffer->end_of_stream()) {
+      if (decoder_->Flush()) return Code::kOk;
+      failed_ = true;
+      return Error();
+    }
+    if (buffer->decrypt_config()) return Fail(Code::kUnsupportedEncryptionMode);
+    if (buffer->timestamp() == media::kNoTimestamp)
+      return Fail(Code::kMissingTimestamp);
+    if (!buffer->data_size() || buffer->data_size() > 64u * 1024u * 1024u ||
+        stream_id_ == INT_MAX)
+      return Fail(Code::kUnsupportedConfig);
+    timestamp_ = buffer->timestamp();
+    duration_ = buffer->duration();
+    decoder_->SetStream(++stream_id_, *buffer);
+    // Parsing and blocking backend calls stay on this dedicated worker.
+    for (unsigned changes = 0; changes < 256; ++changes) {
+      const auto result = decoder_->Decode();
+      Diagnostic("parser", static_cast<int>(result));
+      switch (result) {
+        case media::AcceleratedVideoDecoder::kRanOutOfStreamData:
+          return Code::kOk;
+        case media::AcceleratedVideoDecoder::kConfigChange:
+        case media::AcceleratedVideoDecoder::kColorSpaceChange:
+          if (decoder_->GetBitDepth() != 8 ||
+              decoder_->GetChromaSampling() != media::VideoChromaSampling::k420)
+            return Fail(Code::kUnsupportedConfig);
+          continue;
+        default:
+          // This synchronous backend never requests resource/context retries.
+          failed_ = true;
+          return Error();
+      }
+    }
+    return Fail(Code::kUnsupportedConfig);
+  }
+  void Reset(OutputCB output) {
+    output_ = std::move(output);
+    if (decoder_) decoder_->Reset();
+    else session_.Reset();
+    failed_ = session_.faulted();
+    last_error_ = Code::kOk;
+    stream_id_ = 0;
+  }
+
+ private:
+  class Accelerator final : public media::H264Decoder::H264Accelerator {
+   public:
+    explicit Accelerator(Core* core) : core_(core) {}
+    scoped_refptr<media::H264Picture> CreateH264Picture() override {
+      auto picture = base::MakeRefCounted<Picture>();
+      picture->timestamp = core_->timestamp_;
+      picture->duration = core_->duration_;
+      return picture;
+    }
+    bool RequiresRefLists() override { return true; }
+    AccelStatus SubmitFrameMetadata(
+        const media::H264SPS* sps, const media::H264PPS* pps,
+        const media::H264DPB&, const media::H264Picture::Vector& p0,
+        const media::H264Picture::Vector&, const media::H264Picture::Vector&,
+        scoped_refptr<media::H264Picture> picture) override {
+      Clear();
+      if (!sps || !pps || !picture || picture->decrypt_config() || p0.size() > 16)
+        return Reject(Code::kUnsupportedConfig);
+      sps_ = *sps;
+      pps_ = *pps;
+      current_ = std::move(picture);
+      refs_ = p0;
+      auto* target = static_cast<Picture*>(current_.get());
+      auto aspect = core_->config_.aspect_ratio();
+      if (!aspect.IsValid())
+        aspect = media::VideoAspectRatio::PAR(sps->sar_width, sps->sar_height);
+      target->natural_size = aspect.GetNaturalSize(target->visible_rect());
+      return AccelStatus::kOk;
+    }
+    AccelStatus SubmitSlice(
+        const media::H264PPS*, const media::H264SliceHeader* slice,
+        const media::H264Picture::Vector&, const media::H264Picture::Vector&,
+        scoped_refptr<media::H264Picture> picture, const uint8_t* data, size_t size,
+        const std::vector<media::SubsampleEntry>& subsamples) override {
