+- (id)accessibilityHitTest:(NSPoint)point {
+  if (!node_ || !NSPointInRect(point, [self boundsInScreen]))
+    return nil;
+
+  NSEnumerator* children =
+      [[self accessibilityChildren] reverseObjectEnumerator];
+  id child;
+  while ((child = [children nextObject])) {
+    // Native Leopard children expose geometry through the legacy attributes.
+    NSValue* position =
+        [child accessibilityAttributeValue:NSAccessibilityPositionAttribute];
+    NSValue* size =
+        [child accessibilityAttributeValue:NSAccessibilitySizeAttribute];
+    if (!position || !size)
+      continue;
+    NSRect bounds;
+    bounds.origin = [position pointValue];
+    bounds.size = [size sizeValue];
+    if (!NSPointInRect(point, bounds))
+      continue;
+    if (id hit = [child accessibilityHitTest:point])
+      return hit;
+  }
+  return NSAccessibilityUnignoredAncestor(self);
+}
