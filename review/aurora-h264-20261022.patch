+#include "replay_video_decoder.h"
+#include "base/functional/bind.h"
+#include "base/task/bind_post_task.h"
+#include "base/task/thread_pool.h"
+#include "base/threading/sequence_bound.h"
+#include "media/base/media_util.h"
+#include "media/base/video_frame.h"
+#include "media/filters/ffmpeg_video_decoder.h"
+
+namespace aurora_uvd {
+namespace {
+class WorkerFFmpegDecoder final : public media::VideoDecoder {
+ public:
+  WorkerFFmpegDecoder()
+      : core_(base::ThreadPool::CreateSingleThreadTaskRunner(
+            {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+             base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+            base::SingleThreadTaskRunnerThreadMode::DEDICATED)) {}
+  ~WorkerFFmpegDecoder() override = default;
+  void Initialize(const media::VideoDecoderConfig& config, bool low_delay,
+      media::CdmContext* cdm, InitCB done, const OutputCB& output,
+      const media::WaitingCB& waiting) override {
+    core_.AsyncCall(&Core::Initialize).WithArgs(config, low_delay, cdm,
+        base::BindPostTaskToCurrentDefault(std::move(done)),
+        base::BindPostTaskToCurrentDefault(output),
+        waiting ? base::BindPostTaskToCurrentDefault(waiting) : media::WaitingCB());
+  }
+  void Decode(scoped_refptr<media::DecoderBuffer> buffer, DecodeCB done) override {
+    core_.AsyncCall(&Core::Decode).WithArgs(std::move(buffer),
+        base::BindPostTaskToCurrentDefault(std::move(done)));
+  }
+  void Reset(base::OnceClosure done) override {
+    core_.AsyncCall(&Core::Reset).WithArgs(base::BindPostTaskToCurrentDefault(std::move(done)));
+  }
+  media::VideoDecoderType GetDecoderType() const override {
+    return media::VideoDecoderType::kFFmpeg;
+  }
+ private:
+  class Core {
+   public:
+    Core() : decoder_(&log_) {}
+    void Initialize(media::VideoDecoderConfig config, bool low_delay,
+        media::CdmContext* cdm, InitCB done, OutputCB output, media::WaitingCB waiting) {
+      decoder_.Initialize(config, low_delay, cdm, std::move(done), output, waiting);
