+#ifndef AURORA_UVD_WIRE_VALIDATION_H_
+#define AURORA_UVD_WIRE_VALIDATION_H_
+#include <stdint.h>
+#include <stddef.h>
+#include "rdn_video.h"
+namespace aurora_uvd {
+template<size_t N> inline bool ZeroWords(const uint32_t (&v)[N]) {
+  for (auto word : v) if (word) return false;
+  return true;
+}
+inline bool SameToken(rdn_video_token a, rdn_video_token b) {
+  return (a.high || a.low) && a.high == b.high && a.low == b.low;
+}
+template<class T> inline bool ValidHeader(const T& v, size_t received) {
+  return received == sizeof(T) && v.version == RDN_VIDEO_API_VERSION &&
+         v.bytes == sizeof(T) && ZeroWords(v.reserved);
+}
+inline bool ValidPlanes(uint32_t w, uint32_t h, uint32_t format,
+                        uint32_t ys, uint32_t us, uint32_t yo, uint32_t uo,
+                        uint32_t bytes) {
+  if (!w || !h || (w & 15) || (h & 15) || w > 1920 || h > 1088 ||
+      format != RDN_VIDEO_FORMAT_NV12 || ys < w || us < w ||
+      ys > 8192 || us > 8192 || !bytes || bytes > 4u * 1024 * 1024)
+    return false;
+  const uint64_t ye = uint64_t(yo) + uint64_t(ys) * (h - 1) + w;
+  const uint64_t ue = uint64_t(uo) + uint64_t(us) * (h / 2 - 1) + w;
+  return ye <= bytes && ue <= bytes && (ye <= uo || ue <= yo);
+}
+inline bool ValidSession(const rdn_video_session& v, size_t received,
+                         const rdn_uvd_h264_config& config) {
+  return ValidHeader(v, received) && (v.session.high || v.session.low) &&
+      v.coded_width == config.coded_width && v.coded_height == config.coded_height &&
+      v.upload_bytes && v.upload_bytes <= RDN_VIDEO_MAX_UPLOAD_BYTES &&
+      v.output_slots == RDN_VIDEO_OUTPUT_SLOTS &&
+      v.upload_memory_type == RDN_VIDEO_MEMORY_UPLOAD &&
+      v.output0_memory_type == RDN_VIDEO_MEMORY_OUTPUT0 &&
+      v.output1_memory_type == RDN_VIDEO_MEMORY_OUTPUT1 &&
+      ValidPlanes(v.coded_width, v.coded_height, v.format, v.y_stride,
+                  v.uv_stride, v.y_offset, v.uv_offset, v.output_bytes);
+}
+inline bool ValidOutput(const rdn_video_output& v, size_t received,
+                        const rdn_video_session& s, uint32_t request,
+                        uint32_t sequence) {
+  return ValidHeader(v, received) && SameToken(v.session, s.session) &&
+      v.request_sequence == request && v.output_sequence == sequence &&
+      v.slot < RDN_VIDEO_OUTPUT_SLOTS && !v.flags &&
+      v.coded_width == s.coded_width && v.coded_height == s.coded_height &&
+      v.format == s.format && v.y_stride == s.y_stride &&
+      v.uv_stride == s.uv_stride && v.y_offset == s.y_offset &&
+      v.uv_offset == s.uv_offset && v.output_bytes == s.output_bytes;
+}
+}
