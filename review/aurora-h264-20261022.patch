+ private:
+  struct Mapping { mach_vm_address_t address = 0; mach_vm_size_t bytes = 0; uint32_t type = 0; };
+  bool Map(size_t slot, uint32_t type, uint32_t bytes, bool read_only) {
+    auto& map = maps_[slot];
+    map.type = type;
+    kern_return_t result = IOConnectMapMemory(connection_, type, mach_task_self(),
+        &map.address, &map.bytes, kIOMapAnywhere | (read_only ? kIOMapReadOnly : 0));
+    const uint64_t rounded = (uint64_t(bytes) + 4095) & ~uint64_t(4095);
