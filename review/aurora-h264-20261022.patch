+#include "annex_b_replay.h"
+#include "media/base/timestamp_constants.h"
+#include "media/video/h264_bit_reader.h"
+
+namespace aurora_uvd {
+namespace {
+bool ReadUE(media::H264BitReader* bits, int* value) {
+  int bit, zeros = 0, suffix = 0;
+  while (bits->ReadBits(1, &bit)) {
+    if (bit) {
+      if (zeros && !bits->ReadBits(zeros, &suffix)) return false;
+      *value = int((uint32_t(1) << zeros) - 1 + uint32_t(suffix));
+      return true;
+    }
+    if (++zeros > 30) return false;
+  }
+  return false;
+}
+bool ReadSE(media::H264BitReader* bits, int* value) {
+  int code;
+  if (!ReadUE(bits, &code)) return false;
+  *value = (code & 1) ? code / 2 + 1 : -(code / 2);
+  return true;
+}
+// Chromium rejects PAFF; read only the picture identity and let FFmpeg decode it.
+bool ReadFieldIdentity(media::H264Parser* parser, const media::H264NALU& nalu,
+                       media::H264SliceHeader* slice) {
+  media::H264BitReader bits;
+  if (nalu.size <= 1 || !bits.Initialize(nalu.data + 1, nalu.size - 1) ||
+      !ReadUE(&bits, &slice->first_mb_in_slice) ||
+      !ReadUE(&bits, &slice->slice_type) || slice->slice_type >= 10 ||
+      !ReadUE(&bits, &slice->pic_parameter_set_id)) return false;
+  const auto* pps = parser->GetPPS(slice->pic_parameter_set_id);
+  const auto* sps = pps ? parser->GetSPS(pps->seq_parameter_set_id) : nullptr;
+  if (!sps || sps->separate_colour_plane_flag || sps->frame_mbs_only_flag ||
+      sps->log2_max_frame_num_minus4 < 0 || sps->log2_max_frame_num_minus4 > 12)
+    return false;
+  int field, bottom;
+  if (!bits.ReadBits(sps->log2_max_frame_num_minus4 + 4, &slice->frame_num) ||
+      !bits.ReadBits(1, &field) || !field || !bits.ReadBits(1, &bottom)) return false;
+  slice->field_pic_flag = true;
+  slice->bottom_field_flag = bottom;
+  if (slice->idr_pic_flag && !ReadUE(&bits, &slice->idr_pic_id)) return false;
+  if (sps->pic_order_cnt_type == 0) {
+    if (sps->log2_max_pic_order_cnt_lsb_minus4 < 0 ||
+        sps->log2_max_pic_order_cnt_lsb_minus4 > 12 ||
+        !bits.ReadBits(sps->log2_max_pic_order_cnt_lsb_minus4 + 4,
+                       &slice->pic_order_cnt_lsb)) return false;
+  } else if (sps->pic_order_cnt_type == 1 && !sps->delta_pic_order_always_zero_flag) {
+    if (!ReadSE(&bits, &slice->delta_pic_order_cnt0)) return false;
+  }
+  return true;
+}
+bool NewPicture(const media::H264SliceHeader& a,
+                const media::H264SliceHeader& b) {
+  return a.frame_num != b.frame_num ||
+      a.pic_parameter_set_id != b.pic_parameter_set_id ||
+      a.field_pic_flag != b.field_pic_flag ||
+      (a.field_pic_flag && a.bottom_field_flag != b.bottom_field_flag) ||
+      ((a.nal_ref_idc == 0) != (b.nal_ref_idc == 0)) ||
+      a.idr_pic_flag != b.idr_pic_flag ||
+      (b.idr_pic_flag && (a.idr_pic_id != b.idr_pic_id || !b.first_mb_in_slice)) ||
+      a.pic_order_cnt_lsb != b.pic_order_cnt_lsb ||
+      a.delta_pic_order_cnt_bottom != b.delta_pic_order_cnt_bottom ||
+      a.delta_pic_order_cnt0 != b.delta_pic_order_cnt0 ||
+      a.delta_pic_order_cnt1 != b.delta_pic_order_cnt1;
+}
+void Append(std::vector<uint8_t>* bytes, const media::H264NALU& nalu) {
+  bytes->insert(bytes->end(), {0, 0, 0, 1});
+  bytes->insert(bytes->end(), nalu.data, nalu.data + nalu.size);
+}
+}  // namespace
+void AnnexBReplay::Clear() {
+  parser_ = std::make_unique<media::H264Parser>();
+  parameters_.clear();
+  parameter_bytes_ = 0;
+}
+bool AnnexBReplay::Save(int type, int id, const media::H264NALU& nalu) {
+  if (id < 0 || id >= (type == media::H264NALU::kSPS ? 32 : 256)) return false;
+  auto key = std::make_pair(type, id);
+  auto found = parameters_.find(key);
+  size_t previous = found == parameters_.end() ? 0 : found->second.size();
+  if (size_t(nalu.size) + 4 > 65536 - (parameter_bytes_ - previous)) return false;
+  auto& saved = parameters_[key];
+  saved.clear();
+  Append(&saved, nalu);
+  parameter_bytes_ += saved.size();
+  parameter_bytes_ -= previous;
+  return true;
+}
+std::vector<uint8_t> AnnexBReplay::Parameters() const {
+  std::vector<uint8_t> result;
+  for (const auto& item : parameters_)
+    result.insert(result.end(), item.second.begin(), item.second.end());
+  return result;
+}
+bool AnnexBReplay::Split(const media::DecoderBuffer& input,
+                        std::vector<ReplayAccessUnit>* output) {
+  output->clear();
+  if (input.end_of_stream() || input.decrypt_config() || !input.data_size() ||
+      input.data_size() > 64u * 1024u * 1024u ||
+      input.timestamp() == media::kNoTimestamp) return false;
+  parser_->SetStream(input.data(), input.data_size());
+  std::vector<uint8_t> bytes, parameters;
+  bool picture = false, idr = false;
+  media::H264SliceHeader previous;
+  auto emit = [&]() {
+    if (bytes.empty()) return true;
+    if (output->size() == 512) return false;
+    ReplayAccessUnit unit;
+    unit.buffer = media::DecoderBuffer::CopyFrom(bytes.data(), bytes.size());
+    unit.buffer->set_timestamp(input.timestamp());
+    unit.buffer->set_duration(input.duration());
+    unit.buffer->set_is_key_frame(idr);
+    unit.idr = idr;
+    unit.picture = picture;
+    if (picture) {
+      unit.field = previous.field_pic_flag;
+      unit.bottom = previous.bottom_field_flag;
+      unit.frame_num = previous.frame_num;
+      unit.pps_id = previous.pic_parameter_set_id;
+      unit.reference = previous.nal_ref_idc != 0;
+    }
+    unit.parameters = std::move(parameters);
+    output->push_back(std::move(unit));
+    bytes.clear();
+    picture = idr = false;
+    return true;
+  };
+  media::H264NALU nalu;
+  media::H264Parser::Result result;
+  while ((result = parser_->AdvanceToNextNALU(&nalu)) == media::H264Parser::kOk) {
+    const int type = nalu.nal_unit_type;
+    if (picture && (type == media::H264NALU::kAUD ||
+                    type == media::H264NALU::kSEIMessage ||
+                    type == media::H264NALU::kSPS || type == media::H264NALU::kPPS))
+      if (!emit()) return false;
+    if (type == media::H264NALU::kSPS || type == media::H264NALU::kPPS) {
+      int id;
+      auto parsed = type == media::H264NALU::kSPS ? parser_->ParseSPS(&id) : parser_->ParsePPS(&id);
+      if (parsed != media::H264Parser::kOk || !Save(type, id, nalu)) return false;
+    } else if (type == media::H264NALU::kNonIDRSlice || type == media::H264NALU::kIDRSlice) {
+      media::H264SliceHeader slice;
+      auto parsed = parser_->ParseSliceHeader(nalu, &slice);
+      if (parsed != media::H264Parser::kOk &&
+          !(parsed == media::H264Parser::kUnsupportedStream && slice.field_pic_flag &&
+            ReadFieldIdentity(parser_.get(), nalu, &slice))) return false;
+      if (picture && NewPicture(previous, slice) && !emit()) return false;
+      if (!picture) {
+        picture = true;
+        idr = slice.idr_pic_flag;
+        if (idr) parameters = Parameters();
+      }
+      previous = slice;
+    } else if (type == media::H264NALU::kSliceDataA ||
+               type == media::H264NALU::kSliceDataB ||
+               type == media::H264NALU::kSliceDataC || type >= media::H264NALU::kSPSExt) {
+      return false;
+    }
+    Append(&bytes, nalu);
+  }
+  return result == media::H264Parser::kEOStream && emit() && !output->empty();
+}
+}  // namespace aurora_uvd
