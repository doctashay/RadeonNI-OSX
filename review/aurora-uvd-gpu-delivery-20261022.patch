+    GLint native_name = 0;
+    glGetTexParameteriv(GL_TEXTURE_2D, 0x3481 /* GL_TEXTURE_NATIVE_ID_ANGLE */, &native_name);
+    valid = native_name != 0 && glGetError() == GL_NO_ERROR;
+    if (i) request.destination_uv = static_cast<uint32_t>(native_name);
+    else request.destination_y = static_cast<uint32_t>(native_name);
+  }
+  int result = RDN_GL_VIDEO_PACK_FAILED_RETIRED;
+  if (valid) {
+    auto* current = CGLGetCurrentContext();
+    if (current && bridge_.make_current(current)) result = bridge_.pack(&request);
+  }
+  const bool retired = result == RDN_GL_VIDEO_PACK_OK ||
+      result == RDN_GL_VIDEO_PACK_UNSUPPORTED || result == RDN_GL_VIDEO_PACK_FAILED_RETIRED;
+  if (result == RDN_GL_VIDEO_PACK_OK) {
+    for (auto& plane : planes) plane->SetCleared();
+  }
+  for (auto& scoped : access) scoped.reset();
+  for (auto& plane : planes) plane.reset();
+  if (result != RDN_GL_VIDEO_PACK_OK) {
+    for (unsigned i = 0; i < created; ++i) std::move(destroy[i]).Run(gpu::SyncToken());
+    std::move(done).Run(retired, nullptr);
+    return;
+  }
+  gpu::MailboxHolder holders[media::VideoFrame::kMaxPlanes];
+  for (unsigned i = 0; i < 2; ++i)
+    holders[i] = gpu::MailboxHolder(mailboxes[i], gpu::SyncToken(), GL_TEXTURE_2D);
+  auto release = base::BindPostTask(gpu_runner_, base::BindOnce(
+      [](decltype(destroy) callbacks, const gpu::SyncToken& token) {
+        for (auto& callback : callbacks) std::move(callback).Run(token);
+      }, std::move(destroy)));
+  auto frame = media::VideoFrame::WrapNativeTextures(
+      media::PIXEL_FORMAT_NV12, holders, std::move(release),
+      gfx::Size(source.width, source.height), metadata.visible_rect,
+      metadata.natural_size, metadata.timestamp);
+  if (!frame) {
+    for (const auto& mailbox : mailboxes) factory->DestroySharedImage(mailbox);
+  } else {
+    frame->set_color_space(metadata.color_space);
+    frame->metadata().read_lock_fences_enabled = true;
+    frame->metadata().power_efficient = true;
+  }
+  std::move(done).Run(true, std::move(frame));
+}
+
+ConvertGpuFrameCB CreateGpuFrameConverter(
+    scoped_refptr<base::SequencedTaskRunner> gpu_runner,
+    RadeonUvdFrameConverter::GetStubCB get_stub) {
+  return CreateGpuFrameConverterForTesting(std::move(gpu_runner), std::move(get_stub), GetBridge());
+}
+ConvertGpuFrameCB CreateGpuFrameConverterForTesting(
+    scoped_refptr<base::SequencedTaskRunner> gpu_runner,
+    RadeonUvdFrameConverter::GetStubCB get_stub, GpuPackingFunctions functions) {
+  if (!gpu_runner || !get_stub || !functions.query || !functions.pack ||
+      !functions.make_current) return {};
+  auto converter = base::MakeRefCounted<RadeonUvdFrameConverter>(
+      gpu_runner, std::move(get_stub), functions);
+  return base::BindPostTask(gpu_runner, base::BindRepeating(
+      &RadeonUvdFrameConverter::Convert, std::move(converter)));
+}
