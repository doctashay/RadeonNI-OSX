+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef MEDIA_GPU_MAC_RADEON_UVD_RADEON_UVD_GL_BRIDGE_H_
+#define MEDIA_GPU_MAC_RADEON_UVD_RADEON_UVD_GL_BRIDGE_H_
+
+#include <stdint.h>
+
+#define RDN_GL_VIDEO_PACK_VERSION_1 1u
+#define RDN_GL_VIDEO_PACK_CAP_NV12_COMPLETED 1u
+#define RDN_GL_VIDEO_PACK_MAX_TIMEOUT_MS 2000u
+
+enum RDNGLVideoPackResult {
+  RDN_GL_VIDEO_PACK_OK = 0,
+  RDN_GL_VIDEO_PACK_UNSUPPORTED = 1,
+  RDN_GL_VIDEO_PACK_FAILED_RETIRED = 2,
+  RDN_GL_VIDEO_PACK_FAILED_PENDING = 3
+};
+
+struct RDNGLVideoPackRequestV1 {
+  uint32_t version;
+  uint32_t bytes;
+  uint32_t flags;
+  uint32_t video_connection;
+  uint32_t source_token[8];
+  uint32_t coded_width;
+  uint32_t coded_height;
+  uint32_t destination_y;
+  uint32_t destination_uv;
+  uint32_t timeout_ms;
+  uint32_t reserved[7];
+};
+
+// Native Mesa names in the current context; Y is R8 and UV is RG8.
+// The kernel resolves the token and validates dimensions and ownership.
+// OK means the entire GPU write completed, with no CPU pixel-copy fallback.
+// On PENDING the bridge retains submitted BOs until completion or quarantine;
+// the caller must abandon the source lease, never release it for reuse.
+typedef int (*RDNGLQueryVideoPackingV1Proc)(uint32_t version,
+                                         uint32_t* capabilities);
+typedef int (*RDNGLPackVideoFrameV1Proc)(
+    const struct RDNGLVideoPackRequestV1* request);
+
+#endif  // MEDIA_GPU_MAC_RADEON_UVD_RADEON_UVD_GL_BRIDGE_H_
