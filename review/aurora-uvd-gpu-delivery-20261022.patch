+class RadeonUvdGpuContinuationTest : public testing::Test {
+ public:
+  void SetUp() override {
+    auto convert = base::BindPostTaskToCurrentDefault(base::BindRepeating(
+        &RadeonUvdGpuContinuationTest::Convert, base::Unretained(this)));
+    decoder_ = std::make_unique<RadeonUvdVideoDecoder>(
+        std::make_unique<MockBackend>(&state_), std::move(convert));
+    media::VideoDecoderConfig config(
+        media::VideoCodec::kH264, media::H264PROFILE_BASELINE,
+        media::VideoDecoderConfig::AlphaMode::kIsOpaque, media::VideoColorSpace::REC709(),
+        media::VideoTransformation(), gfx::Size(320, 192), gfx::Rect(320, 192),
+        gfx::Size(320, 192), {}, media::EncryptionScheme::kUnencrypted);
+    base::test::TestFuture<media::DecoderStatus> initialized;
+    decoder_->Initialize(config, false, nullptr, initialized.GetCallback(),
+        base::BindRepeating([](scoped_refptr<media::VideoFrame>) {}), {});
+    ASSERT_TRUE(initialized.Get().is_ok());
+    auto buffer = media::ReadTestDataFile("bear-320x192-baseline-frame-0.h264");
+    buffer->set_timestamp(base::TimeDelta());
+    decoder_->Decode(buffer, decoded_.GetCallback());
+    ASSERT_TRUE(converted_.Wait());
+    EXPECT_FALSE(decoded_.IsReady());
+  }
+  void TearDown() override {
+    decoder_.reset();
+    pending_.Reset();
+    tasks_.RunUntilIdle();
+  }
+  void Convert(GpuOutput source, GpuFrameMetadata metadata, GpuFrameReadyCB done) {
+    source_ = source;
+    metadata_ = metadata;
+    pending_ = std::move(done);
+    converted_.SetValue();
+  }
+  void Complete() {
+    auto frame = media::VideoFrame::CreateFrame(media::PIXEL_FORMAT_NV12,
+        gfx::Size(source_.width, source_.height), metadata_.visible_rect,
+        metadata_.natural_size, metadata_.timestamp);
+    std::move(pending_).Run(true, std::move(frame));
+  }
+ protected:
+  base::test::TaskEnvironment tasks_;
+  State state_;
+  std::unique_ptr<RadeonUvdVideoDecoder> decoder_;
+  base::test::TestFuture<media::DecoderStatus> decoded_;
+  base::test::TestFuture<void> converted_;
+  GpuOutput source_;
+  GpuFrameMetadata metadata_;
+  GpuFrameReadyCB pending_;
+};
+TEST_F(RadeonUvdGpuContinuationTest, ConversionCompletionResumesParserOnce) {
+  EXPECT_EQ(state_.decodes, 1u);
+  Complete();
+  EXPECT_TRUE(decoded_.Get().is_ok());
+  EXPECT_EQ(state_.decodes, 1u);
+  EXPECT_EQ(state_.retires, 1u);
+  EXPECT_EQ(state_.quarantines, 0u);
+}
+TEST_F(RadeonUvdGpuContinuationTest, ResetWaitsForSourceRetirement) {
+  base::test::TestFuture<void> reset;
+  decoder_->Reset(reset.GetCallback());
+  tasks_.RunUntilIdle();
+  EXPECT_FALSE(reset.IsReady());
+  EXPECT_EQ(state_.destroys, 0u);
+  Complete();
+  EXPECT_TRUE(reset.Wait());
+  EXPECT_EQ(decoded_.Get().code(), media::DecoderStatus::Codes::kAborted);
+  EXPECT_EQ(state_.retires, 1u);
+  EXPECT_EQ(state_.destroys, 1u);
+}
+TEST_F(RadeonUvdGpuContinuationTest, DestructionRetainsConnectionThroughGpuCallback) {
+  decoder_.reset();
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(state_.destroys, 0u);
+  Complete();
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(state_.retires, 1u);
+  EXPECT_EQ(state_.destroys, 1u);
+}
+TEST_F(RadeonUvdGpuContinuationTest, DroppedConversionQuarantinesAfterDestruction) {
+  decoder_.reset();
+  pending_.Reset();
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(state_.quarantines, 1u);
+  EXPECT_EQ(state_.destroys, 1u);
+}
