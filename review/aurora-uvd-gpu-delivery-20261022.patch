+  RadeonUvdFrameConverter(scoped_refptr<base::SequencedTaskRunner>, GetStubCB,
+                           GpuPackingFunctions);
+  void Convert(GpuOutput source, GpuFrameMetadata metadata, GpuFrameReadyCB done);
+
