+ uint32_t output_sequence, slot, reserved[2];
+};
+struct rdn_video_destroy {
+ uint32_t version, bytes;
+ struct rdn_video_token session;
+ uint32_t reserved[4];
+};
+/* Tokens are opaque and valid only on the creating video connection. */
+struct rdn_video_gpu_output {
+ uint32_t version, bytes, source_token[8];
+ uint32_t request_sequence, coded_width, coded_height, layout, reserved[2];
+};
+struct rdn_video_gpu_acquire {
+ uint32_t version, bytes, source_token[8], reserved[6];
+};
+/* Offsets are relative to target; vram_offset names the allocation, not a BO. */
+struct rdn_video_gpu_source {
+ uint32_t version, bytes, source_token[8];
+ uint32_t vram_offset, target_bytes, pitch, coded_width, coded_height;
+ uint32_t y_top, y_bottom, uv_top, uv_bottom, layout, reserved[4];
+};
+/* RETIRED requires no submission or a completed GPU fence; PENDING quarantines. */
+struct rdn_video_gpu_retire {
+ uint32_t version, bytes, source_token[8], role, outcome, reserved[4];
+};
+#endif
