+TEST(RadeonUvdGpuSessionTest, CapabilityIsRequiredBeforeCreate) {
+  State state;
+  state.gpu = false;
+  Session session(std::make_unique<MockBackend>(&state));
+  GpuOutput output;
+  EXPECT_EQ(session.DecodeGpu(TestMetadata(), true, kSlice, &output), BackendStatus::kUnsupported);
+  EXPECT_EQ(state.creates, 0u);
+  EXPECT_EQ(state.decodes, 0u);
+}
+TEST(RadeonUvdGpuSessionTest, TargetCannotBeReusedBeforeRetirement) {
+  State state;
+  Session session(std::make_unique<MockBackend>(&state));
+  GpuOutput first, second;
+  ASSERT_EQ(session.DecodeGpu(TestMetadata(), true, kSlice, &first), BackendStatus::kOk);
+  EXPECT_EQ(session.DecodeGpu(TestMetadata(), false, kSlice, &second), BackendStatus::kFailure);
+  EXPECT_EQ(session.Reset(), BackendStatus::kFailure);
+  EXPECT_EQ(state.decodes, 1u);
+  EXPECT_EQ(state.destroys, 0u);
+  ASSERT_EQ(session.RetireGpu(first, true), BackendStatus::kOk);
+  ASSERT_EQ(session.DecodeGpu(TestMetadata(), false, kSlice, &second), BackendStatus::kOk);
+  EXPECT_NE(first.source_token[0], second.source_token[0]);
+  EXPECT_EQ(session.RetireGpu(second, true), BackendStatus::kOk);
+  EXPECT_EQ(session.Reset(), BackendStatus::kOk);
+  EXPECT_EQ(state.retires, 2u);
+  EXPECT_EQ(state.destroys, 1u);
+}
+TEST(RadeonUvdGpuSessionTest, StaleTokenCannotReleaseCurrentTarget) {
+  State state;
+  Session session(std::make_unique<MockBackend>(&state));
+  GpuOutput output;
+  ASSERT_EQ(session.DecodeGpu(TestMetadata(), true, kSlice, &output), BackendStatus::kOk);
+  auto stale = output;
+  ++stale.source_token[7];
+  EXPECT_EQ(session.RetireGpu(stale, true), BackendStatus::kFailure);
+  EXPECT_EQ(state.retires, 0u);
+  EXPECT_EQ(session.RetireGpu(output, true), BackendStatus::kOk);
+  EXPECT_EQ(session.RetireGpu(output, true), BackendStatus::kFailure);
+  EXPECT_EQ(state.retires, 1u);
+}
+TEST(RadeonUvdGpuSessionTest, UnknownGpuCompletionIsTerminal) {
+  State state;
+  Session session(std::make_unique<MockBackend>(&state));
+  GpuOutput output;
+  ASSERT_EQ(session.DecodeGpu(TestMetadata(), true, kSlice, &output), BackendStatus::kOk);
+  session.RetireGpu(output, false);
+  EXPECT_TRUE(session.faulted());
+  EXPECT_EQ(state.quarantines, 1u);
+  EXPECT_EQ(session.DecodeGpu(TestMetadata(), true, kSlice, &output), BackendStatus::kFailure);
+  EXPECT_EQ(state.decodes, 1u);
+}
+TEST(RadeonUvdGpuSessionTest, InvalidResolvedGeometryIsQuarantined) {
+  State state;
+  state.bad_geometry = true;
+  Session session(std::make_unique<MockBackend>(&state));
