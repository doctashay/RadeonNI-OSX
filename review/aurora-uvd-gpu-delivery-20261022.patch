+};
+class MockBackend final : public Backend {
+ public:
+  explicit MockBackend(State* state) : state_(state) {}
+  BackendStatus Query(Capabilities* caps) override {
+    *caps = {true, 7, 1920, 1088, 4u * 1024u * 1024u, state_->gpu};
+    return BackendStatus::kOk;
+  }
+  BackendStatus Create(const rdn_uvd_h264_config&) override {
+    ++state_->creates;
+    return BackendStatus::kOk;
+  }
+  BackendStatus CreateGpu(const rdn_uvd_h264_config& config) override {
+    return Create(config);
+  }
+  BackendStatus Decode(const Metadata&, const std::vector<uint8_t>&, LinearNV12*) override {
+    return BackendStatus::kUnsupported;
+  }
+  BackendStatus DecodeGpu(const Metadata& m, const std::vector<uint8_t>&, GpuOutput* out) override {
+    *out = {};
+    out->video_connection = 123;
+    out->source_token[0] = ++state_->decodes;
+    out->source_token[7] = 0xfedcba98;
+    out->width = m.config.coded_width + (state_->bad_geometry ? 16 : 0);
+    out->height = m.config.coded_height;
+    return BackendStatus::kOk;
+  }
+  BackendStatus RetireGpu(const GpuOutput&, bool complete) override {
+    ++state_->retires;
+    if (!complete) ++state_->quarantines;
+    return BackendStatus::kOk;
+  }
+  BackendStatus Destroy() override {
+    ++state_->destroys;
+    return BackendStatus::kOk;
+  }
+ private:
+  State* state_;
+};
