+BackendStatus Session::DecodeGpu(const Metadata& metadata, bool idr,
+                                  const std::vector<uint8_t>& bytes,
+                                  GpuOutput* output) {
+  if (!output) return BackendStatus::kFailure;
+  auto status = Prepare(metadata, idr, bytes, true);
+  if (status != BackendStatus::kOk) return status;
+  GpuOutput candidate;
+  status = backend_->DecodeGpu(metadata, bytes, &candidate);
+  if (status != BackendStatus::kOk) {
+    faulted_ = true;
+    return status;
+  }
+  uint32_t token = 0;
+  for (uint32_t word : candidate.source_token) token |= word;
+  if (!candidate.video_connection || !token ||
+      candidate.width != config_.coded_width ||
+      candidate.height != config_.coded_height) {
+    backend_->RetireGpu(candidate, false);
+    faulted_ = true;
+    return BackendStatus::kFailure;
+  }
+  gpu_output_ = candidate;
+  gpu_pending_ = true;
+  *output = candidate;
+  return BackendStatus::kOk;
+}
+BackendStatus Session::RetireGpu(const GpuOutput& output, bool completed) {
+  if (!gpu_pending_ || memcmp(&output, &gpu_output_, sizeof(output)))
+    return BackendStatus::kFailure;
+  gpu_pending_ = false;
+  auto status = backend_->RetireGpu(output, completed);
+  if (!completed || status != BackendStatus::kOk) faulted_ = true;
+  gpu_output_ = {};
+  return status;
+}
