+namespace {
+static_assert(sizeof(RDNGLVideoPackRequestV1) == 96, "GL bridge ABI");
+
+struct Bridge : public GpuPackingFunctions {
+  Bridge() {
+    void* driver = dlopen("/System/Library/Extensions/RadeonNIGLDriver.bundle/"
+                          "Contents/MacOS/RadeonNIGLDriver", RTLD_LAZY | RTLD_LOCAL);
+    if (!driver) return;
+    query = reinterpret_cast<RDNGLQueryVideoPackingV1Proc>(
+        dlsym(driver, "RDNGLQueryVideoPackingV1"));
+    pack = reinterpret_cast<RDNGLPackVideoFrameV1Proc>(
+        dlsym(driver, "RDNGLPackVideoFrameV1"));
+    make_current = reinterpret_cast<int (*)(void*)>(
+        dlsym(driver, "RDNGLMakeCurrent"));
+  }
+};
+Bridge& GetBridge() {
+  static Bridge bridge;
+  return bridge;
+}
+
+bool ValidSource(const GpuOutput& source, const GpuFrameMetadata& metadata) {
+  uint32_t token = 0;
+  for (uint32_t word : source.source_token) token |= word;
+  return source.video_connection && token &&
+      source.width >= 64 && source.height >= 64 &&
+      source.width <= 1920 && source.height <= 1088 &&
+      !(source.width & 1) && !(source.height & 1) &&
+      !metadata.visible_rect.IsEmpty() && !metadata.natural_size.IsEmpty() &&
+      gfx::Rect(source.width, source.height).Contains(metadata.visible_rect);
+}
+}  // namespace
+
+RadeonUvdFrameConverter::RadeonUvdFrameConverter(
+    scoped_refptr<base::SequencedTaskRunner> runner, GetStubCB get_stub,
+    GpuPackingFunctions functions)
+    : base::RefCountedDeleteOnSequence<RadeonUvdFrameConverter>(runner),
+      gpu_runner_(std::move(runner)), get_stub_(std::move(get_stub)), bridge_(functions) {}
+
+RadeonUvdFrameConverter::~RadeonUvdFrameConverter() {
+  DCHECK(gpu_runner_->RunsTasksInCurrentSequence());
+  if (stub_) stub_->RemoveDestructionObserver(this);
+}
+void RadeonUvdFrameConverter::OnWillDestroyStub(bool) {
+  DCHECK(gpu_runner_->RunsTasksInCurrentSequence());
+  stub_->RemoveDestructionObserver(this);
+  stub_ = nullptr;
+  images_ = nullptr;
+}
+bool RadeonUvdFrameConverter::Initialize() {
+  if (!initialized_) {
+    initialized_ = true;
+    stub_ = get_stub_.Run();
+    if (stub_) {
+      stub_->AddDestructionObserver(this);
+      images_ = stub_->channel()->shared_image_stub();
+    }
+  }
+  return stub_ && images_ && images_->factory();
+}
+
+void RadeonUvdFrameConverter::Convert(GpuOutput source,
+                                       GpuFrameMetadata metadata,
+                                       GpuFrameReadyCB done) {
+  DCHECK(gpu_runner_->RunsTasksInCurrentSequence());
+  if (!ValidSource(source, metadata) || !Initialize()) {
+    std::move(done).Run(true, nullptr);
+    return;
+  }
+  auto* factory = images_->factory();
+  auto* context = factory->GetSharedContextState();
+  if (!context || context->context_lost() || !context->MakeCurrent(nullptr, true)) {
+    std::move(done).Run(true, nullptr);
