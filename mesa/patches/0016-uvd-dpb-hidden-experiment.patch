+/*
+ * osx-gpu: a buffer only the video engine and the command processor touch (the decoder's picture
+ * buffer): in video memory the CPU cannot reach, so that it does not use the aperture's share.
+ */
+bool rvid_create_hidden_buffer(struct pipe_screen *screen, struct rvid_buffer *buffer,
+			       unsigned size);
+
 /* destroy a buffer */
 void rvid_destroy_buffer(struct rvid_buffer *buffer);
 
