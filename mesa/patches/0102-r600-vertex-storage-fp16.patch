+
+/* Keep half values packed in registers; execute arithmetic at full precision. */
+static unsigned
+r600_lower_half_alu(const nir_instr *instr, void *)
+{
+   if (instr->type != nir_instr_type_alu)
+      return 0;
+   const nir_alu_instr *alu = nir_instr_as_alu(instr);
+   const nir_op_info *info = &nir_op_infos[alu->op];
+   for (unsigned i = 0; i < info->num_inputs; ++i) {
+      if (info->input_types[i] == nir_type_float &&
+          alu->src[i].src.ssa->bit_size == 16)
+         return 32;
+   }
+   return 0;
+}
+
+static nir_mem_access_size_align
+r600_half_access(nir_intrinsic_op, uint8_t bytes, uint8_t bits,
+                 uint32_t align_mul, uint32_t align_offset, bool,
+                 enum gl_access_qualifier, const void *scalarize)
+{
+   nir_mem_access_size_align result = {};
+   result.bit_size = bits == 16 && !scalarize ? 32 : bits;
+   result.num_components = bits == 16 ? 1 : bytes / (bits / 8);
+   result.align = bits == 16 ? (scalarize ? 2 : 4) :
+                              nir_combined_align(align_mul, align_offset);
+   return result;
+}
+
+static bool
+r600_half_memory_endian(nir_builder *b, nir_intrinsic_instr *intr, void *)
+{
+#if UTIL_ARCH_BIG_ENDIAN
+   unsigned bits;
+   switch (intr->intrinsic) {
+   case nir_intrinsic_load_ssbo:
+   case nir_intrinsic_load_shared:
+   case nir_intrinsic_load_scratch:
+      bits = intr->def.bit_size;
+      break;
+   case nir_intrinsic_store_ssbo:
+   case nir_intrinsic_store_shared:
+   case nir_intrinsic_store_scratch:
+      bits = intr->src[0].ssa->bit_size;
+      break;
+   default:
+      return false;
+   }
+   if (bits != 16)
+      return false;
+   nir_src *offset = nir_get_io_offset_src(intr);
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_src_rewrite(offset, nir_ixor(b, offset->ssa, nir_imm_intN_t(b, 2, offset->ssa->bit_size)));
+   nir_intrinsic_set_align(intr, 2, 0);
+   return true;
+#else
+   return false;
+#endif
+}
+
+static bool
+r600_half_from_integer(nir_builder *b, nir_alu_instr *alu, void *)
+{
+   nir_op wide;
+   switch (alu->op) {
+   case nir_op_i2f16: wide = nir_op_i2f32; break;
+   case nir_op_u2f16: wide = nir_op_u2f32; break;
+   case nir_op_b2f16: wide = nir_op_b2f32; break;
+   default: return false;
+   }
+   b->cursor = nir_before_instr(&alu->instr);
+   b->fp_math_ctrl = alu->fp_math_ctrl;
+   nir_def *value = nir_build_alu(b, wide, nir_ssa_for_alu_src(b, alu, 0), nullptr, nullptr, nullptr);
+   nir_def_replace(&alu->def, nir_f2f16(b, value));
+   return true;
+}
+
+static void
+r600_lower_half(nir_shader *sh)
+{
+   nir_lower_mem_access_bit_sizes_options mem = {};
+   mem.callback = r600_half_access;
+   mem.modes = nir_var_mem_ubo | nir_var_mem_ssbo | nir_var_mem_shared |
+               nir_var_function_temp;
+   mem.may_lower_unaligned_stores_to_atomics = true;
+   mem.cb_data = &mem;
+   NIR_PASS(_, sh, nir_lower_mem_access_bit_sizes, &mem);
+   NIR_PASS(_, sh, nir_shader_intrinsics_pass, r600_half_memory_endian,
+            nir_metadata_control_flow, nullptr);
+   mem.cb_data = nullptr;
+   NIR_PASS(_, sh, nir_lower_mem_access_bit_sizes, &mem);
+   NIR_PASS(_, sh, nir_shader_alu_pass, r600_half_from_integer,
+            nir_metadata_control_flow, nullptr);
+   NIR_PASS(_, sh, nir_lower_bit_size, r600_lower_half_alu, nullptr);
+   NIR_PASS(_, sh, nir_lower_fp16_casts, nir_lower_fp16_all);
+   NIR_PASS(_, sh, nir_lower_pack);
 }
 
