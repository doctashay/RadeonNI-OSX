+/*
+ * Darwin/PowerPC opt-in (RDN_STATIC_HIDDEN=1 in the program's environment):
+ * application vertex and index buffers with default or immutable usage are
+ * GPU-only, so the winsys places them in hidden video memory (where live
+ * eviction can move them) instead of the CPU-visible aperture or the pinned
+ * GART budget. Writes go through staging copies; buffers the CPU reads back,
+ * maps persistently, shares or uses for anything else keep normal placement.
+ */
+static bool r600_darwin_static_hidden(struct r600_common_screen *rscreen,
+				      const struct pipe_resource *templ)
+{
+#if defined(__APPLE__) && (defined(__ppc__) || defined(__ppc64__))
+	static int enabled = -1;
+	const unsigned allowed = PIPE_BIND_VERTEX_BUFFER | PIPE_BIND_INDEX_BUFFER;
+
+	if (enabled < 0) {
+		const char *value = getenv("RDN_STATIC_HIDDEN");
+		enabled = value && atoi(value) != 0;
+		if (enabled)
+			fputs("RadeonNI: static vertex/index buffers in hidden VRAM\n", stderr);
+	}
+	return enabled && rscreen->info.has_cp_dma &&
+	       (templ->usage == PIPE_USAGE_DEFAULT || templ->usage == PIPE_USAGE_IMMUTABLE) &&
+	       (templ->bind & allowed) && !(templ->bind & ~allowed) &&
+	       !(templ->flags & (PIPE_RESOURCE_FLAG_MAP_PERSISTENT |
+				 PIPE_RESOURCE_FLAG_MAP_COHERENT |
+				 PIPE_RESOURCE_FLAG_SPARSE));
+#else
+	return false;
+#endif
+}
+
 struct pipe_resource *r600_buffer_create(struct pipe_screen *screen,
 					 const struct pipe_resource *templ,
 					 unsigned alignment)
@@ -560,6 +597,9 @@
 
 	r600_init_resource_fields(rscreen, rbuffer, templ->width0, alignment);
 
+	if (r600_darwin_static_hidden(rscreen, templ))
