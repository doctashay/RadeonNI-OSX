+/* osx-gpu: as rvid_create_buffer, in video memory the CPU cannot map (see radeon_video.h) */
+bool rvid_create_hidden_buffer(struct pipe_screen *screen, struct rvid_buffer *buffer,
+			       unsigned size)
+{
+	struct pipe_resource templ;
+
+	memset(buffer, 0, sizeof(*buffer));
+	buffer->usage = PIPE_USAGE_DEFAULT;
+	memset(&templ, 0, sizeof(templ));
+	templ.target = PIPE_BUFFER;
+	templ.format = PIPE_FORMAT_R8_UNORM;
+	templ.bind = PIPE_BIND_SHARED;
+	templ.usage = PIPE_USAGE_DEFAULT;
+	templ.flags = R600_RESOURCE_FLAG_UNMAPPABLE;
+	templ.width0 = size;
+	templ.height0 = 1;
+	templ.depth0 = 1;
+	templ.array_size = 1;
+	buffer->res = r600_as_resource(screen->resource_create(screen, &templ));
+
+	return buffer->res != NULL;
+}
+
 /* destroy a buffer */
