glthread: have a callback run in the worker thread after a batch

A double-buffered full-screen program swaps buffers by a copy that has to
come after the frame's last call. Waiting for the worker thread to finish
the frame (_mesa_glthread_finish) at every swap takes away what glthread
gives (Quake 3 148 to 120 frames a second, Doom 3 49 to 34 on the G5).
_mesa_glthread_set_done_callback attaches a function to the batch being
filled; the worker thread calls it when the batch has run.

diff -ruN a/src/mesa/main/glthread.c b/src/mesa/main/glthread.c
--- a/src/mesa/main/glthread.c
+++ b/src/mesa/main/glthread.c
@@ -151,6 +151,15 @@
    assert(pos == used);
    batch->used = 0;
 
+   if (batch->done_cb) {
+      void (*cb)(void *) = batch->done_cb;
+      void *arg = batch->done_arg;
+
+      batch->done_cb = NULL;
+      batch->done_arg = NULL;
+      cb(arg);
+   }
+
    unsigned batch_index = batch - ctx->GLThread.batches;
    _mesa_glthread_signal_call(&ctx->GLThread.LastProgramChangeBatch, batch_index);
    _mesa_glthread_signal_call(&ctx->GLThread.LastDListChangeBatchIndex, batch_index);
@@ -353,6 +362,25 @@
    glthread->LastBindBuffer2 = NULL;
 }
 
+/**
+ * osx-gpu: have cb(arg) called in the worker thread after the calls queued
+ * so far, in the batch being filled, have run. The caller queues a call
+ * after this (glFlush) and flushes the batch. False: no glthread, or a
+ * callback is already waiting in this batch.
+ */
+bool
+_mesa_glthread_set_done_callback(struct gl_context *ctx, void (*cb)(void *),
+                                 void *arg)
+{
+   struct glthread_state *glthread = &ctx->GLThread;
+
+   if (!glthread->enabled || glthread->next_batch->done_cb)
+      return false;
+   glthread->next_batch->done_cb = cb;
+   glthread->next_batch->done_arg = arg;
+   return true;
+}
+
 void
 _mesa_glthread_flush_batch(struct gl_context *ctx)
 {
diff -ruN a/src/mesa/main/glthread.h b/src/mesa/main/glthread.h
--- a/src/mesa/main/glthread.h
+++ b/src/mesa/main/glthread.h
@@ -160,6 +160,9 @@
     */
    unsigned used;
 
+   void (*done_cb)(void *arg);
+   void *done_arg;
+
    /** Data contained in the command buffer. */
    uint64_t buffer[MARSHAL_MAX_CMD_BUFFER_SIZE / 8];
 };
@@ -332,6 +335,8 @@
 void _mesa_glthread_enable(struct gl_context *ctx);
 void _mesa_glthread_disable(struct gl_context *ctx);
 void _mesa_glthread_flush_batch(struct gl_context *ctx);
+bool _mesa_glthread_set_done_callback(struct gl_context *ctx,
+                                      void (*cb)(void *), void *arg);
 void _mesa_glthread_finish(struct gl_context *ctx);
 void _mesa_glthread_finish_before(struct gl_context *ctx, const char *func);
 bool _mesa_glthread_invalidate_zsbuf(struct gl_context *ctx);
